---
import ComponentRow from './ComponentRow.astro';
import BlockTable from './BlockTable.astro';
import { blockGroups } from '../../lib/brand-blocks';
---

<ul role="list" class="brand-parts">
  {blockGroups.map((group) => (
    <ComponentRow id={group.id} use={group.use} rule={group.rule}>
      <BlockTable group={group} mode="dark" />
      <div slot="light">
        <BlockTable group={group} mode="light" />
      </div>
    </ComponentRow>
  ))}
</ul>
