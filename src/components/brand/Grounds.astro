---
import ComponentRow from './ComponentRow.astro';
---

<ul role="list" class="brand-parts">
  <ComponentRow
    id="ground-background"
    use="the page itself, behind everything."
    rule="Background color; text and subtle text sit on it directly."
  >
    <div class="edge border-border bg-background p-card-tight sm:p-card">
      <p class="mb-paragraph text-body text-text">Text on the page ground.</p>
      <p class="text-body text-subtle">
        Subtle text for dates and other details.
      </p>
    </div>
  </ComponentRow>

  <ComponentRow
    id="ground-surface"
    use="cards, inputs and anything raised off the page."
    rule="Cards are gold or light blocks with a 4px ink edge and a pink shadow; the header bar is a gold block of the same kind in both modes."
  >
    <div class="card">
      <p class="mb-paragraph text-body text-text">Text on the surface.</p>
      <p class="text-body text-subtle">
        Subtle text for dates and other details.
      </p>
    </div>
  </ComponentRow>

  <ComponentRow
    id="ground-gold"
    use="a page's opening and its closing block."
    rule="Gold-text on gold, gold-muted for dates and other details, the gold buttons; in light mode the slab turns white and its text near-black."
  >
    <div class="surface-gold edge border-border p-card-tight sm:p-card">
      <p class="text-body">Text on the gold slab.</p>
      <p class="mt-6">
        <a href="#ground-gold" class="btn-gold-primary">
          Gold Primary
        </a>
      </p>
    </div>
  </ComponentRow>

  <ComponentRow
    id="ground-solid"
    use="one card that leads a group."
    rule="The light third surface; only background-colored text passes on it."
  >
    <div class="card card-solid">
      <p class="text-body">Text on the light card.</p>
    </div>
  </ComponentRow>
</ul>
