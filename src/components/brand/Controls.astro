---
import ThemeSwitch from '../ThemeSwitch.astro';
import ComponentRow from './ComponentRow.astro';
import DoDont from './DoDont.astro';

/* Examples only: src/scripts/brand-examples.ts flips their own name and glyph. */
const MOTION_EXAMPLES = [
  {
    id: 'pause-control',
    use: 'anything that moves for more than 5 seconds, like the homepage hero.',
    rule: 'Present whenever motion is; gone under reduced motion, where nothing moves.',
    on: { label: 'Pause the animation', glyph: '❚❚' },
    off: { label: 'Play the animation', glyph: '▶' },
  },
  {
    id: 'sleep-control',
    use: 'stopping one moving figure, like a cat on About.',
    rule: 'One per figure, beside it; the name says what pressing it will do.',
    on: { label: 'Put the cat to sleep', glyph: 'z' },
    off: { label: 'Wake the cat', glyph: '•' },
  },
] as const;
---

<ul role="list" class="brand-parts">
  {MOTION_EXAMPLES.map((example) => (
    <ComponentRow id={example.id} use={example.use} rule={example.rule}>
      <div class="needs-script relative h-12">
        <button
          type="button"
          class="motion-toggle top-0 left-0"
          data-example-toggle
          data-on-label={example.on.label}
          data-on-glyph={example.on.glyph}
          data-off-label={example.off.label}
          data-off-glyph={example.off.glyph}
        >
          <span aria-hidden="true" class="text-label leading-none" data-glyph>
            {example.on.glyph}
          </span>
          <span class="sr-only" data-label>
            {example.on.label}
          </span>
        </button>
      </div>
      <p class="mt-4 text-body text-subtle">This example moves nothing.</p>
      <p class="needs-script-note mt-4 text-body text-subtle">
        This example needs JavaScript.
      </p>
    </ComponentRow>
  ))}

  <ComponentRow
    id="theme-switch"
    use="choosing System, Light or Dark."
    rule="Opens three choices. System follows the device and is the default; Light or Dark is remembered. It shows the theme in use and works like the one in the header."
  >
    <div class="needs-script">
      <ThemeSwitch id="theme-menu-sample" />
    </div>
    <p class="needs-script-note text-body text-subtle">
      This example needs JavaScript.
    </p>
  </ComponentRow>

  <ComponentRow
    id="focus-ring"
    use="showing where the keyboard is."
    rule="A 4px cyan ring with a gap on every control; dark on gold and inside blocks. Never removed."
  >
    <a href="#focus-ring" class="btn-secondary">
      Tab to This Button
    </a>
    <Fragment slot="states">
      <DoDont
        doText="Cyan on hover and focus only."
        dontText="Cyan at rest: it no longer signals a state."
      >
        <span slot="do" class="btn-primary">
          Rest
        </span>
        <span slot="dont" class="btn-primary state-hover">
          At Rest
        </span>
      </DoDont>
    </Fragment>
  </ComponentRow>
</ul>

<script>
  import '../../scripts/brand-examples';
</script>
