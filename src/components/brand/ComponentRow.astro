---
/*
 * One /brand row: the component's name, what it is for, the rule that matters,
 * one live example and, when it has them, its other states behind a + toggle.
 */
interface Props {
  id: string;
  name: string;
  use: string;
  rule: string;
}

const { id, name, use, rule } = Astro.props;
const hasStates = Astro.slots.has('states');
---

<li class="py-8" data-component={id}>
  <h3 id={id} class="text-h3 text-text">
    {name}
  </h3>
  <p class="mt-2 mb-paragraph max-w-measure text-body text-text">
    Use it for {use}
  </p>
  <p class="max-w-measure text-body text-subtle">{rule}</p>
  <div class="mt-6" data-example>
    <slot />
  </div>
  {hasStates && (
    <details class="mt-6">
      <summary class="post-contents-summary">
        <span>States</span>
        <span class="post-contents-marker" aria-hidden="true" />
      </summary>
      <div class="mt-6" data-example>
        <slot name="states" />
      </div>
    </details>
  )}
</li>
