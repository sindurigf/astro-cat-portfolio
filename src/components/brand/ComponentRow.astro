---
/*
 * One /brand part: its name, what it is for, the rule that matters, then its
 * example on the dark ground (live) beside the light one (an inert copy, so
 * nothing is reached or named twice), its other states under it. A `light`
 * slot replaces the copy with live content of its own, for facts that differ
 * by mode, such as contrast ratios.
 */
import { PART_ACCESSIBILITY } from '../../lib/brand-a11y';
import { brandPartName } from '../../lib/brand-sections';
import { inertCopy, sourceOf } from './mirror';

interface Props {
  /* A part id from src/lib/brand-sections.ts, which holds its name. */
  id: string;
  use?: string;
  rule: string;
}

const { id, use, rule } = Astro.props;
const example = await Astro.slots.render('default');
const states = Astro.slots.has('states')
  ? `<div class="mt-8">${await Astro.slots.render('states')}</div>`
  : '';
const live = example + states;
const keeps = PART_ACCESSIBILITY[id];
const ownLight = Astro.slots.has('light')
  ? await Astro.slots.render('light')
  : null;
---

<li data-component={id}>
  <h3 id={id} class="text-h3 text-text">
    {brandPartName(id)}
  </h3>
  <div class="mt-2 max-w-measure text-body">
    {use && <p class="mb-paragraph text-text">Use it for {use}</p>}
    <p class:list={['text-subtle', keeps && 'mb-paragraph']}>{rule}</p>
    {keeps && (
      <p class="text-subtle">
        <b class="font-black text-text">Accessibility</b> {keeps}
      </p>
    )}
  </div>
  <div class="brand-stage mt-6">
    <div class="brand-stage-half mode-dark" data-example>
      <div class="label text-subtle">Dark</div>
      <div class="mt-4">
        <Fragment set:html={live} />
      </div>
    </div>
    {ownLight === null ? (
      <div class="brand-stage-half mode-light" inert aria-hidden="true">
        <div class="label text-subtle">Light</div>
        <div class="mt-4">
          <Fragment set:html={inertCopy(live)} />
        </div>
      </div>
    ) : (
      <div class="brand-stage-half mode-light" data-example>
        <div class="label text-subtle">Light</div>
        <div class="mt-4">
          <Fragment set:html={ownLight} />
        </div>
      </div>
    )}
  </div>
  {ownLight === null && (
    <div class="mt-6">
      <div class="label text-subtle">Markup</div>
      <Fragment
        set:html={`<div class="brand-code-frame"><pre class="brand-code" data-copy="markup for ${brandPartName(id)}"><code>${sourceOf(example)}</code></pre></div>`}
      />
    </div>
  )}
</li>

<script>
  import '../../scripts/copy';
</script>
