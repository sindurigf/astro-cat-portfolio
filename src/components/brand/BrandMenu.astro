---
/*
 * /brand's sections list: every section, numbered, linking to its place on the
 * page. Closed under `lg`, like a post's contents; open beside the content from
 * it. The section you jumped to is the gold block (brand.css).
 */
import {
  BRAND_GROUPS,
  BRAND_SECTIONS,
  sectionNumber,
} from '../../lib/brand-sections';
---

<nav aria-label="On This Page" id="brand-menu" tabindex="-1" class="brand-menu">
  {(['narrow', 'wide'] as const).map((width) => {
    const list = (
      <ol role="list">
        {BRAND_GROUPS.map((group) => (
          <li>
            <span class="brand-menu-group">{group}</span>
            <ol role="list">
              {BRAND_SECTIONS.filter((s) => s.group === group).map((s) => (
                <li>
                  <a class="brand-menu-link" href={`#${s.anchor}`}>
                    <span>{s.title}</span>
                    <span class="brand-menu-number" aria-hidden="true">
                      {sectionNumber(s.slug)}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    );
    const filtered = (
      <div data-menu-list>
        <div class="needs-script mb-6">
          <label class="field-label" for={`menu-filter-${width}`}>
            Search
          </label>
          <input
            class="field-control"
            id={`menu-filter-${width}`}
            type="search"
            autocomplete="off"
            placeholder="Token, hex, component, rule"
            data-menu-filter
          />
          <p
            class="mt-3 text-body text-subtle"
            role="status"
            data-menu-status
          />
        </div>
        {list}
      </div>
    );
    return width === 'narrow' ? (
      <details class="lg:hidden">
        <summary class="post-contents-summary">
          <span>On This Page</span>
          <span class="post-contents-marker" aria-hidden="true" />
        </summary>
        {filtered}
      </details>
    ) : (
      <div class="hidden lg:block">{filtered}</div>
    );
  })}
</nav>

<script>
  import '../../scripts/brand-filter';
</script>
