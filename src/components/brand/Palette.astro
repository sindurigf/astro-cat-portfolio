---
import ComponentRow from './ComponentRow.astro';
import { colors } from '../../lib/brand';
import { brandSection } from '../../lib/brand-sections';
import { GLYPH, SWATCH, SWATCH_BOX } from './swatches';
---

<ul role="list" class="brand-parts">
  <ComponentRow id="palette" rule={brandSection('color').rule}>
    <ul role="list" class="space-y-6">
      {colors.map(({ token, job, dark, light }) => {
        const swatch = SWATCH[token];
        return (
          <li class="flex items-center gap-6">
            {swatch === null ? (
              <span
                class:list={[
                  SWATCH_BOX,
                  'border-4 border-dashed border-border',
                ]}
                aria-hidden="true"
              />
            ) : GLYPH.test(swatch) ? (
              <span
                class:list={[SWATCH_BOX, 'text-display font-black', swatch]}
                aria-hidden="true"
              >
                Aa
              </span>
            ) : (
              <span class:list={[SWATCH_BOX, swatch]} aria-hidden="true" />
            )}
            <dl class="min-w-0">
              <dt class="text-body font-black text-text">
                <code>{token}</code>
              </dt>
              <dd class="text-body text-subtle">{job}</dd>
              <dd class="text-body text-subtle">
                Dark {dark}
                {light !== dark && <>, light {light}</>}
              </dd>
            </dl>
          </li>
        );
      })}
    </ul>
  </ComponentRow>
</ul>
