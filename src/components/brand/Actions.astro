---
import ComponentRow from './ComponentRow.astro';
import DoDont from './DoDont.astro';
import StateRow from './StateRow.astro';

const META = 'text-body text-subtle';
---

<ul role="list" class="brand-parts">
  <ComponentRow
    id="primary-button"
    use="the one main action in a section."
    rule="One per section. At rest it casts a pink shadow; under the pointer it fills cyan and lifts off its shadow; pressed, it sinks into it."
  >
    <a href="#primary-button" class="btn-primary">
      Primary Action
    </a>
    <Fragment slot="states">
      <StateRow button="btn-primary" label="Primary Action" />
      <p class={`mt-6 ${META}`}>
        Unavailable is aria-disabled: dashed edge, no shadow, still reachable by
        keyboard.
      </p>
      <div class="mt-8">
        <DoDont
          doText="One primary in a section, with a secondary beside it."
          dontText="Two primaries side by side: nothing stands out."
        >
          <p slot="do" class="flex flex-wrap gap-6">
            <span class="btn-primary">Save</span>
            <span class="btn-secondary">Cancel</span>
          </p>
          <p slot="dont" class="flex flex-wrap gap-6">
            <span class="btn-primary">Save</span>
            <span class="btn-primary">Send</span>
          </p>
        </DoDont>
      </div>
    </Fragment>
  </ComponentRow>

  <ComponentRow
    id="secondary-button"
    use="an action beside the primary one."
    rule="Same shape and states as the primary, as a light block; never two primaries side by side."
  >
    <p class="flex flex-wrap gap-6">
      <a href="#primary-button" class="btn-primary">
        Primary Action
      </a>
      <a href="#secondary-button" class="btn-secondary">
        Secondary Action
      </a>
    </p>
    <Fragment slot="states">
      <StateRow button="btn-secondary" label="Secondary Action" />
    </Fragment>
  </ComponentRow>

  <ComponentRow
    id="gold-buttons"
    use="actions on a gold slab or a page's closing block."
    rule="Only the gold pair goes on gold: a dark primary with a light label, and an outlined secondary. The focus ring turns dark."
  >
    <div class="surface-gold edge border-border p-card-tight sm:p-card">
      <p class="flex flex-wrap gap-6">
        <a href="#gold-buttons" class="btn-gold-primary">
          Primary on Gold
        </a>
        <a href="#ground-gold" class="btn-gold-secondary">
          Secondary on Gold
        </a>
      </p>
    </div>
  </ComponentRow>

  <ComponentRow
    id="text-links"
    use="a link inside a sentence."
    rule="Underlined at rest, a thicker underline under the pointer. A visited link looks the same."
  >
    <p class="text-body text-text">
      Read the <a href="/accessibility/">accessibility statement</a> for what is
      tested and how.
    </p>
  </ComponentRow>

  <ComponentRow
    id="standalone-links"
    use="a link on its own line, outside a sentence."
    rule="The .link class keeps the underline; a 44px minimum height keeps it a large enough target."
  >
    <p class="text-body text-text">
      <a
        href="/accessibility/"
        class="link inline-flex min-h-target items-center"
      >
        Accessibility Statement
      </a>
    </p>
  </ComponentRow>
</ul>
