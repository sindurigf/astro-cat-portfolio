---
/*
 * One role in one mode: its tokens as rows of one swatch size, then the one
 * pair it is read on and that pair's ratio.
 */
import type { Mode, Role } from '../../lib/brand-roles';

interface Props {
  role: Role;
  mode: Mode;
}

const { role, mode } = Astro.props;
const read = role.read[mode];
---

<ul role="list" class="role-list">
  {role.tokens.map((t) => (
    <li class="role-token" data-token={t.token}>
      <span
        class:list={[
          'role-swatch',
          t.swatch.paint === 'glyph' && 'role-swatch-glyph',
          t.swatch.cls,
        ]}
        data-paint={t.swatch.paint}
        aria-hidden="true"
      >
        {t.swatch.paint === 'glyph' && 'Aa'}
      </span>
      <span class="min-w-0">
        <code class="block text-body font-black text-text">{t.token}</code>
        <span class="block text-label text-subtle">{t.job}</span>
        <span class="role-hex block text-label text-subtle">{t.hex[mode]}</span>
      </span>
    </li>
  ))}
</ul>
<p
  class="role-read mt-6 text-body text-subtle"
  data-fg={read.fg}
  data-bg={read.bg}
  data-kind={read.kind}
>
  {read.fg} / {read.bg}{' '}
  <b class="role-ratio font-black text-text">{read.ratio}:1</b>{' '}
  <span class="role-verdict">{read.verdict}</span>
</p>
