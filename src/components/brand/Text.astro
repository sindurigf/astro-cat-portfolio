---
import ComponentRow from './ComponentRow.astro';

const CODE_LABEL = 'Code, scrolls sideways';
---

<ul class="divide-y-4 divide-border">
  <ComponentRow
    id="prose"
    name="Prose"
    use="running text: posts and reading pages."
    rule="Lines of about 70 characters; links underlined; lists keep their markers."
  >
    <div class="prose">
      <p>
        A paragraph of running text with a <a href="/accessibility/">link</a>{' '}
        and some <code>inline code</code>.
      </p>
      <ul>
        <li>A List Item</li>
        <li>Another List Item</li>
      </ul>
    </div>
  </ComponentRow>

  <ComponentRow
    id="blockquote"
    name="Quote"
    use="words from someone else, set apart from the text."
    rule="A thick edge on its start side; the source sits below it."
  >
    <div class="prose">
      <blockquote>
        <p>Knowledge is safest when many people hold it, not one.</p>
      </blockquote>
    </div>
  </ComponentRow>

  <ComponentRow
    id="code-block"
    name="Code Block"
    use="code a reader may copy."
    rule="Scrolls sideways, never wraps, and takes keyboard focus so a keyboard can scroll it."
  >
    <div class="prose">
      <pre
        tabindex="0"
        role="group"
        aria-label={CODE_LABEL}
      ><code>npm run build && npm run check</code></pre>
    </div>
  </ComponentRow>

  <ComponentRow
    id="standfirst"
    name="Standfirst and Lead"
    use="the one or two lines that open a page or a section."
    rule="Larger than body text at the reading weight; one per page or section."
  >
    <p class="standfirst">
      A standfirst opens a page in a line or two, just under its title.
    </p>
    <p class="lead mt-8">
      A lead opens a section in a line or two, just under its heading.
    </p>
  </ComponentRow>

  <ComponentRow
    id="bullet-list"
    name="Bullet List"
    use="short points outside prose."
    rule="Square pink markers; one point per line."
  >
    <ul class="bullet-list text-body text-text">
      <li>A Point</li>
      <li>Another Point</li>
    </ul>
  </ComponentRow>
</ul>
