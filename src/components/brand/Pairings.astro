---
import ComponentRow from './ComponentRow.astro';
import ContrastTable from '../ContrastTable.astro';
import { contrast, lightContrast } from '../../lib/brand';
import { brandSection } from '../../lib/brand-sections';

/* The pairings every page is read in, shown before the full list. */
const READING = {
  fg: ['text', 'subtle'],
  bg: ['background', 'surface'],
  job: 'text',
};
const isReading = (row: (typeof contrast)[number]): boolean =>
  READING.fg.includes(row.fg) &&
  READING.bg.includes(row.bg) &&
  row.job === READING.job;
const readingPairs = contrast.filter(isReading);
const lightReadingPairs = lightContrast.filter(isReading);
---

<ul role="list" class="brand-parts">
  <ComponentRow id="pairings" rule={brandSection('contrast').rule}>
    <div>
      <ContrastTable rows={readingPairs} caption="Reading Pairs" />
      <details class="mt-head">
        <summary class="post-contents-summary">
          <span>Show All {contrast.length} Pairings</span>
          <span class="post-contents-marker" aria-hidden="true" />
        </summary>
        <div class="mt-6">
          <ContrastTable rows={contrast} caption="All Pairings" />
        </div>
      </details>
    </div>
    <div slot="light">
      <ContrastTable rows={lightReadingPairs} caption="Light Reading Pairs" />
      <details class="mt-head">
        <summary class="post-contents-summary">
          <span>Show All {lightContrast.length} Light Pairings</span>
          <span class="post-contents-marker" aria-hidden="true" />
        </summary>
        <div class="mt-6">
          <ContrastTable rows={lightContrast} caption="All Light Pairings" />
        </div>
      </details>
      <p class="mt-6 text-body text-text">
        Gold text turns to ink on white, with a gold square before the word; on
        a gold block the square is ink.
      </p>
    </div>
  </ComponentRow>
</ul>
