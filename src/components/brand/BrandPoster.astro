---
/*
 * A section's picture on the dark ground beside the light one. The light half
 * is an inert copy; the pictures are decoration.
 */
import BrandSample from './BrandSample.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="brand-stage brand-poster">
  {(['dark', 'light'] as const).map((mode) => (
    <div
      class:list={['brand-stage-half', `mode-${mode}`]}
      inert={mode === 'light'}
      aria-hidden={mode === 'light' ? 'true' : undefined}
    >
      <div class="label text-subtle">{mode === 'dark' ? 'Dark' : 'Light'}</div>
      <div class="mt-8" aria-hidden="true">
        <BrandSample section={slug} />
      </div>
    </div>
  ))}
</div>
