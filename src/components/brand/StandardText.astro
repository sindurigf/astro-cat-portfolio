---
/*
 * Text naming the WCAG standard, each abbreviation expanded at its first use
 * (SC 3.1.4). For a /brand page's first mention only: Abbr's ids are per page.
 */
import Abbr from '../Abbr.astro';

interface Props {
  text: string;
}

const EXPANSIONS: Record<string, string> = {
  WCAG: 'Web Content Accessibility Guidelines',
  AA: "the middle of WCAG's three levels",
  AAA: "the highest of WCAG's three levels",
};

const { text } = Astro.props;
const seen = new Set<string>();
type Part = { text: string } | { short: string; long: string; after?: string };
/* Punctuation right after an abbreviation rides in its `after`, so it keeps the line. */
const LEADING_PUNCTUATION = /^[.,;:!?)]+/;
const parts = text.split(/\b(WCAG|AAA|AA)\b/).map((part): Part => {
  const long = EXPANSIONS[part];
  if (!long || seen.has(part)) return { text: part };
  seen.add(part);
  return { short: part, long };
});
parts.forEach((part, i) => {
  const next = parts[i + 1];
  if (!('short' in part) || !next || !('text' in next)) return;
  const after = LEADING_PUNCTUATION.exec(next.text)?.[0];
  if (!after) return;
  part.after = after;
  next.text = next.text.slice(after.length);
});
---

{parts.map((part) =>
  'short' in part ? (
    <Abbr short={part.short} long={part.long} after={part.after} />
  ) : (
    part.text
  ),
)}
