---
import PageHero from '../PageHero.astro';
import Roundel from '../Roundel.astro';
import ComponentRow from './ComponentRow.astro';
/* Each hero at its real size; from `sm` the band's gutter is put back around it, under it the stage's padding stands in. */
const FRAME = 'hero-example sm:px-6';
---

<ul role="list" class="brand-parts">
  <ComponentRow
    id="hero-full"
    use="the top of a page: its title and one line on what it holds."
    rule="One per page, the page's only h1. Full gold slab for a main page; the box cat roundel sits on its bottom edge."
  >
    <figure class={FRAME}>
      <PageHero title="Page Title" headingLevel={3}>
        <p class="standfirst">
          One or two lines on what the page holds, beside its title.
        </p>
      </PageHero>
    </figure>
    <Fragment slot="states">
      <ul role="list" class="space-y-12">
        <li>
          <p class="mb-6 text-body text-subtle">
            Thin slab: a post, Message Sent or a Brand section page.
          </p>
          <figure class={FRAME}>
            <PageHero title="Post Title" slab="thin" headingLevel={3} />
          </figure>
        </li>
        <li>
          <p class="mb-6 text-body text-subtle">
            Plain: a reading page such as Privacy, with the standfirst below.
          </p>
          <figure class={FRAME}>
            <PageHero title="Read­ing Page" slab="none" headingLevel={3}>
              <p class="standfirst">
                One or two lines on what the page holds, below its title.
              </p>
            </PageHero>
          </figure>
        </li>
      </ul>
    </Fragment>
  </ComponentRow>

  <ComponentRow
    id="roundel"
    use="the logo mark on a slab edge or a closing block."
    rule="The cat in its box, with its own ink edge and pink throw, tilted; never a link."
  >
    <Roundel />
  </ComponentRow>
</ul>
