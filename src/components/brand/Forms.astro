---
import ComponentRow from './ComponentRow.astro';

const META = 'text-body text-subtle';
---

<ul class="divide-y-4 divide-border">
  <ComponentRow
    id="form"
    name="Form"
    use="collecting a short message, as on Contact."
    rule="Each field has a visible label and says when it is required. The submit button is never disabled."
  >
    {/* method="dialog" outside a dialog submits nothing, with or without JavaScript. */}
    <form method="dialog" novalidate class="card">
      <div class="field">
        <label class="field-label" for="example-name">
          Name <span class="field-required">(required)</span>
        </label>
        <input
          class="field-control"
          id="example-name"
          type="text"
          autocomplete="off"
          required
        />
      </div>
      <button class="btn-primary mt-8" type="submit">
        Send message
      </button>
      <p class:list={[META, 'mt-3']}>This example sends nothing.</p>
    </form>
    <Fragment slot="states">
      <ul class="space-y-12">
        <li>
          <p class:list={[META, 'mb-6']}>
            A field with an error: the message is tied to the field and the
            field is marked invalid.
          </p>
          <div class="field">
            <label class="field-label" for="example-email">
              Email <span class="field-required">(required)</span>
            </label>
            <input
              class="field-control"
              id="example-email"
              type="email"
              autocomplete="off"
              value="name@"
              aria-invalid="true"
              aria-describedby="example-email-error"
            />
            <p class="field-error" id="example-email-error">
              Enter an email address like name@example.com
            </p>
          </div>
        </li>
        <li>
          <p class:list={[META, 'mb-6']}>
            The error summary above a form that failed: it takes focus and links
            to each field.
          </p>
          <div class="error-summary" tabindex="-1">
            <h4 class="text-h3 text-text">
              There is one problem with this form
            </h4>
            <ul class="mt-4 list-disc pl-6">
              <li class="mt-2 text-body">
                <a
                  href="#example-email"
                  class="link inline-flex min-h-target items-center"
                >
                  Enter an email address like name@example.com
                </a>
              </li>
            </ul>
          </div>
        </li>
        <li>
          <p class:list={[META, 'mb-6']}>
            Sending: the button keeps focus, says Sending and ignores a second
            press; a status line says what is happening.
          </p>
          <button class="btn-primary" type="button" aria-disabled="true">
            Sending
          </button>
          <p class="mt-3 text-body text-text">Sending your message.</p>
        </li>
      </ul>
    </Fragment>
  </ComponentRow>
</ul>
