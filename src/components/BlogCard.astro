---
import type { BlogCategory, CoverPosition } from '../content.config';
import { formatPostDate } from '../lib/post-date';
import { isoDate } from '../lib/time';
import { categoryLabel } from '../lib/blog';
import { CATEGORY_LABEL } from '../lib/categories';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../lib/photo-formats';
import {
  THUMBNAIL_PX,
  THUMBNAIL_SIZES,
  THUMBNAIL_WIDTHS,
  WIDTHS,
} from '../lib/image-densities';
import { photoSize } from '../lib/photo-size';

/*
 * The link is on the heading, not the whole card: a card-wide <a> would take
 * every word as its name and make the teaser unselectable. A press on the
 * card follows it (src/scripts/card-click.ts). No separate "Read the post"
 * link: a second tab stop to the same URL. A thumbnail is decorative: the
 * heading names the post (H67).
 */

interface Props {
  href: string;
  title: string;
  teaser: string;
  category: BlogCategory;
  date: Date;
  readingTime?: number;
  /** The newest post on /blog: a wide card with the cover beside the text. */
  feature?: boolean;
  /** The newest post's cover drawn whole above the text, at this `sizes` width; else a square thumbnail. */
  largeCoverSizes?: string;
  /** The first card of a listing, above the fold. */
  eager?: boolean;
  headingLevel?: 2 | 3 | 4;
  cover: ImageMetadata;
  coverAlt: string;
  coverPosition: CoverPosition;
  class?: string;
}

const {
  href,
  title,
  teaser,
  category,
  date,
  readingTime,
  feature = false,
  largeCoverSizes,
  eager = false,
  headingLevel = 3,
  cover,
  coverAlt,
  coverPosition,
  class: className = '',
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

/* Half the card from `md`, full width below; tests/image-size.spec.ts fails when it drifts. */
const COVER_SIZES =
  '(min-width: 48rem) min(calc(50vw - 5.5rem), 36rem), (min-width: 40rem) calc(100vw - 9rem), calc(100vw - 6rem)';

const coverSize = await photoSize(cover);
const thumbnail = !feature && largeCoverSizes === undefined;

const machineDate = isoDate(date);
const readableDate = formatPostDate(date);
---

<article class:list={['card @container flex flex-col', className]}>
  <div
    class:list={[
      feature && 'grid gap-8 md:grid-cols-2 md:items-center',
      thumbnail && 'flex flex-col gap-6 @md:flex-row @md:items-start',
    ]}
  >
    {largeCoverSizes === undefined ? null : (
      <div class="aspect-frame mb-8 border-4">
        <svg
          class="aspect-sizer"
          viewBox={`0 0 ${coverSize.width} ${coverSize.height}`}
          aria-hidden="true"
          focusable="false"
        />
        <Picture
          {...PHOTO_FORMATS}
          src={cover}
          alt={coverAlt}
          width={coverSize.width}
          height={coverSize.height}
          widths={WIDTHS}
          sizes={largeCoverSizes}
          loading={eager ? 'eager' : 'lazy'}
        />
      </div>
    )}
    <div class:list={['flex flex-col', thumbnail && 'min-w-0 flex-1']}>
      <span
        class:list={[
          'label flex flex-wrap items-center gap-x-3',
          CATEGORY_LABEL,
        ]}
      >
        <span>{categoryLabel(category)}</span>
        {readingTime ? (
          <Fragment>
            <span aria-hidden="true">&middot;</span>
            <span>{readingTime} minute read</span>
          </Fragment>
        ) : null}
      </span>

      <Heading
        class:list={[
          'post-title mt-4',
          feature ? 'text-post-card-feature' : 'text-post-card',
        ]}
      >
        <a href={href} class="card-link">
          {title}
        </a>
      </Heading>

      <p class="mt-6 max-w-measure text-body text-pretty">{teaser}</p>

      <span class="label mt-8 block text-subtle">
        <time datetime={machineDate}>{readableDate}</time>
      </span>
    </div>

    {thumbnail ? (
      <div class="aspect-frame order-first aspect-square w-32 shrink-0 border-4 @md:order-none">
        <Picture
          {...PHOTO_FORMATS}
          src={cover}
          alt=""
          data-card-thumbnail
          width={THUMBNAIL_PX}
          height={THUMBNAIL_PX}
          fit="cover"
          position={coverPosition}
          widths={THUMBNAIL_WIDTHS}
          sizes={THUMBNAIL_SIZES}
          loading={eager ? 'eager' : 'lazy'}
        />
      </div>
    ) : null}

    {feature ? (
      <div class="aspect-frame mt-2 border-4">
        <svg
          class="aspect-sizer"
          viewBox={`0 0 ${coverSize.width} ${coverSize.height}`}
          aria-hidden="true"
          focusable="false"
        />
        <Picture
          {...PHOTO_FORMATS}
          src={cover}
          alt={coverAlt}
          width={coverSize.width}
          height={coverSize.height}
          widths={WIDTHS}
          sizes={COVER_SIZES}
          priority
        />
      </div>
    ) : null}
  </div>
</article>

<script>
  import '../scripts/card-click';
</script>
