---
import type { BlogCategory } from '../content.config';
import { formatPostDate } from '../lib/post-date';
import { isoDate } from '../lib/time';
import { categoryLabel } from '../lib/blog';
import { CATEGORIES } from '../lib/categories';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../lib/photo-formats';
import PlaceholderBox from './PlaceholderBox.astro';
import { WIDTHS } from '../lib/image-densities';
import { photoSize } from '../lib/photo-size';

/*
 * The link is on the heading, not the whole card: a card-wide <a> would take
 * every word as its name and make the teaser unselectable. No separate "Read
 * the post" link: a second tab stop to the same URL.
 */

interface Props {
  href: string;
  title: string;
  teaser: string;
  category: BlogCategory;
  date: Date;
  readingTime?: number;
  feature?: boolean;
  headingLevel?: 2 | 3 | 4;
  /** Shown only on a `feature` card, where the placeholder box would be. */
  cover?: ImageMetadata;
  coverAlt?: string;
  class?: string;
}

const {
  href,
  title,
  teaser,
  category,
  date,
  readingTime,
  feature = false,
  headingLevel = 3,
  cover,
  coverAlt = '',
  class: className = '',
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

/* Half the card from `md`, full width below; tests/image-size.spec.ts fails when it drifts. */
const COVER_SIZES =
  '(min-width: 48rem) min(calc(50vw - 5.5rem), 36rem), (min-width: 40rem) calc(100vw - 9rem), calc(100vw - 6rem)';

const { accent } = CATEGORIES[category];

const coverSize = feature && cover ? await photoSize(cover) : null;

const machineDate = isoDate(date);
const readableDate = formatPostDate(date);
---

<article class:list={['card flex flex-col', className]}>
  <div
    class:list={[feature ? 'grid gap-8 md:grid-cols-2 md:items-center' : '']}
  >
    <div class="flex flex-col">
      <span
        class:list={['label flex flex-wrap items-center gap-x-3', accent.text]}
      >
        <span>{categoryLabel(category)}</span>
        {readingTime ? (
          <Fragment>
            <span aria-hidden="true">&middot;</span>
            <span>{readingTime} minute read</span>
          </Fragment>
        ) : null}
      </span>

      <Heading
        class:list={[
          'post-title mt-4',
          feature ? 'text-post-card-feature' : 'text-post-card',
        ]}
      >
        <a href={href} class="card-link">
          {title}
        </a>
      </Heading>

      {/* No `text-text`: the utility would beat a solid block's rule (tests/solid-block.spec.ts). */}
      <p class="mt-6 max-w-measure text-body text-pretty">{teaser}</p>

      <span class="label mt-8 block text-subtle">
        <time datetime={machineDate}>{readableDate}</time>
      </span>
    </div>

    {/* No `border-border`: the utility would beat a solid block's rule and fail SC 1.4.11. */}
    {feature && cover && coverSize ? (
      <div class="aspect-frame mt-2 border-4">
        <svg
          class="aspect-sizer"
          viewBox={`0 0 ${coverSize.width} ${coverSize.height}`}
          aria-hidden="true"
          focusable="false"
        />
        <Picture
          {...PHOTO_FORMATS}
          src={cover}
          alt={coverAlt}
          width={coverSize.width}
          height={coverSize.height}
          widths={WIDTHS}
          sizes={COVER_SIZES}
          priority
        />
      </div>
    ) : feature ? (
      <PlaceholderBox label="Post Artwork" class="mt-2" />
    ) : null}
  </div>
</article>
