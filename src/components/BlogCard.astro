---
import type { BlogCategory, CoverPosition } from '../content.config';
import { formatPostDate } from '../lib/post-date';
import { isoDate } from '../lib/time';
import { categoryLabel } from '../lib/blog';
import { CATEGORY_LABEL } from '../lib/categories';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../lib/photo-formats';
import { CARD_COVER_RATIO, WIDTHS } from '../lib/image-densities';
import { photoSize } from '../lib/photo-size';

/*
 * The link is on the heading, not the whole card: a card-wide <a> would take
 * every word as its name and make the teaser unselectable. A press on the
 * card follows it (src/scripts/card-click.ts). No separate "Read the post"
 * link: a second tab stop to the same URL. Cover order and alt:
 * ARCHITECTURE.md#content-notes.
 */

interface Props {
  href: string;
  title: string;
  teaser: string;
  category: BlogCategory;
  date: Date;
  readingTime?: number;
  /** The newest post on /blog: a wide card with a larger title, loaded first. */
  feature?: boolean;
  /** A card filling its row: the cover beside the text from `md`, as on a feature card. */
  wide?: boolean;
  /** The cover's `sizes`, for where this card is drawn. */
  coverSizes: string;
  /** The newest post's card on the homepage and /blog: the cover keeps its alt text. */
  describeCover?: boolean;
  /** The first card of a listing, above the fold. */
  eager?: boolean;
  headingLevel?: 2 | 3 | 4;
  cover: ImageMetadata;
  coverAlt: string;
  coverPosition: CoverPosition;
  class?: string;
}

const {
  href,
  title,
  teaser,
  category,
  date,
  readingTime,
  feature = false,
  wide = false,
  coverSizes,
  describeCover = false,
  eager = false,
  headingLevel = 3,
  cover,
  coverAlt,
  coverPosition,
  class: className = '',
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const beside = feature || wide;

/* The largest crop the cover can give at the card's frame. */
const coverSize = await photoSize(cover);
const cropWidth = Math.min(
  coverSize.width,
  Math.floor(
    (coverSize.height * CARD_COVER_RATIO.width) / CARD_COVER_RATIO.height,
  ),
);
const cropHeight = Math.round(
  (cropWidth * CARD_COVER_RATIO.height) / CARD_COVER_RATIO.width,
);

const machineDate = isoDate(date);
const readableDate = formatPostDate(date);
---

<article class:list={['card flex flex-col', className]}>
  <div class:list={['grid gap-8', beside && 'md:grid-cols-2 md:items-center']}>
    {/* `aspect-4/3` is CARD_COVER_RATIO: the CSP blocks a style attribute. */}
    <div
      class:list={[
        'aspect-frame aspect-4/3 border-4',
        beside && 'md:order-last',
      ]}
    >
      <Picture
        {...PHOTO_FORMATS}
        src={cover}
        alt={describeCover ? coverAlt : ''}
        data-card-cover={describeCover ? undefined : ''}
        width={cropWidth}
        height={cropHeight}
        fit="cover"
        position={coverPosition}
        widths={[
          ...new Set([
            ...WIDTHS.filter((width) => width < cropWidth),
            cropWidth,
          ]),
        ]}
        sizes={coverSizes}
        {...(feature
          ? { priority: true }
          : { loading: eager ? 'eager' : 'lazy' })}
      />
    </div>
    <div class="flex flex-col">
      <span
        class:list={[
          'label flex flex-wrap items-center gap-x-3',
          CATEGORY_LABEL,
        ]}
      >
        <span>{categoryLabel(category)}</span>
        {readingTime ? (
          <Fragment>
            <span aria-hidden="true">&middot;</span>
            <span>{readingTime} minute read</span>
          </Fragment>
        ) : null}
      </span>

      <Heading
        class:list={[
          'post-title mt-4',
          feature ? 'text-post-card-feature' : 'text-post-card',
        ]}
      >
        <a href={href} class="card-link">
          {title}
        </a>
      </Heading>

      <p class="mt-6 max-w-measure text-body text-pretty">{teaser}</p>

      <span class="label mt-8 block text-subtle">
        <time datetime={machineDate}>{readableDate}</time>
      </span>
    </div>
  </div>
</article>

<script>
  import '../scripts/card-click';
</script>
