---
import type { ImageMetadata } from 'astro';
import { getImage, Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../lib/photo-formats';
import { WIDTHS } from '../lib/image-densities';

/*
 * Links to the full-size file; src/scripts/photo-viewer.ts opens it in the
 * viewer, stepping through its `group`. Never cropped: `fluid` fills the width
 * in the photo's own ratio; `natural` sets a fixed height for a `.photo-strip`.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  group: string;
  size?: 'fluid' | 'natural';
  /** `fluid` only. */
  sizes?: string;
  /** `natural` only: one inset at every width, for a strip outside About's layout. */
  stripInset?: string;
}

const { image, alt, group, size = 'fluid', sizes, stripInset } = Astro.props;

/*
 * Size via getImage, not `image.width`: reading the imported Proxy marks the
 * original as used and the build ships the .jpg (check:untransformed).
 */
const { options: untransformed } = await getImage({ src: image });
if (untransformed.width === undefined || untransformed.height === undefined) {
  throw new Error(
    `PhotoTile: no size for ${image.src}. Every photo is an imported file, ` +
      'which carries one.',
  );
}
const master = {
  width: untransformed.width,
  height: untransformed.height,
};

const NATURAL_HEIGHT = 320;

/* Gutter, panel and strip borders and padding; tests/image-size.spec.ts fails on drift. */
const STRIP_INSET = '7.5rem';
/* From `sm` (40rem) the section and card padding grow. */
const STRIP_INSET_SM = '10.5rem';

const naturalWidth = Math.round(
  NATURAL_HEIGHT * (master.width / master.height),
);
const naturalSizes = stripInset
  ? `min(${naturalWidth}px, calc(100vw - ${stripInset}))`
  : `(min-width: 40rem) min(${naturalWidth}px, calc(100vw - ${STRIP_INSET_SM})), min(${naturalWidth}px, calc(100vw - ${STRIP_INSET}))`;

const naturalWidths = [
  ...new Set([
    ...WIDTHS.filter((width) => width <= master.width),
    naturalWidth,
  ]),
].sort((a, b) => a - b);

const FULL_WIDTH = 1600;

const full = await getImage({
  src: image,
  ...(master.width > FULL_WIDTH && { width: FULL_WIDTH }),
  format: 'webp',
});

/*
 * The sizer's width and height are the ratio at this scale, so in a
 * `.photo-pair` row flex shrinks each tile in proportion to its ratio and the
 * photos share one height. Far wider than any row, so it always shrinks.
 */
const PAIR_RATIO_SCALE = 10_000;

const fluidWidths = [
  ...new Set([...WIDTHS.filter((width) => width < master.width), master.width]),
];
const hasCaption = Astro.slots.has('default');
---

<figure class="min-w-0 bg-background p-2">
  {/* `.aspect-frame` is relative, so the sr-only span cannot escape a scrolled strip. */}
  <a href={full.src} class="aspect-frame block" data-photo={group}>
    {size === 'natural' ? (
      <Fragment>
        <svg
          class="strip-photo"
          width={naturalWidth}
          viewBox={`0 0 ${master.width} ${master.height}`}
          aria-hidden="true"
          focusable="false"
        />
        <Picture
          {...PHOTO_FORMATS}
          src={image}
          alt={alt}
          width={naturalWidth}
          widths={naturalWidths}
          sizes={naturalSizes}
        />
      </Fragment>
    ) : (
      <Fragment>
        <svg
          class="aspect-sizer"
          width={Math.round((PAIR_RATIO_SCALE * master.width) / master.height)}
          height={PAIR_RATIO_SCALE}
          viewBox={`0 0 ${master.width} ${master.height}`}
          aria-hidden="true"
          focusable="false"
        />
        <Picture
          {...PHOTO_FORMATS}
          src={image}
          alt={alt}
          width={master.width}
          height={master.height}
          widths={fluidWidths}
          sizes={sizes}
        />
      </Fragment>
    )}
    <span class="sr-only">, opens full size</span>
  </a>
  {/* The photo sets the tile's width; the caption wraps to it. */}
  {hasCaption && (
    <figcaption class="mt-3 w-0 min-w-full bg-background py-card-tight text-body text-text text-pretty">
      <slot />
    </figcaption>
  )}
</figure>
