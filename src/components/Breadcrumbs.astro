---
import type { Crumb } from '../lib/breadcrumbs';

/*
 * Separators are aria-hidden spans: CSS generated-content alt text is not
 * honored in every engine. `hit-target` gives each link a 44px pointer area
 * (SC 2.5.5); `gap-y-8` keeps wrapped rows' areas from overlapping.
 */
interface Props {
  crumbs: readonly Crumb[];
  /* `gold` on a gold slab: `gold-muted`, since `subtle` fails SC 1.4.3 there. */
  tone?: 'page' | 'gold';
  /* Another name only where a page shows a second trail, as /brand's example does. */
  label?: string;
}

const { crumbs, tone = 'page', label = 'Breadcrumb' } = Astro.props;

const TONE_CLASS = { page: 'text-subtle', gold: 'text-gold-muted' } as const;
---

<nav aria-label={label} class="mb-6">
  <ol
    class:list={[
      'label flex flex-wrap items-center gap-x-2 gap-y-8',
      TONE_CLASS[tone],
    ]}
  >
    {crumbs.map((crumb, index) => (
      <li class="flex items-center gap-x-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        <a href={crumb.href} class="link hit-target inline-block">
          {crumb.label}
        </a>
      </li>
    ))}
  </ol>
</nav>
