---
import { THEME_CHOICES } from '../lib/theme';

interface Props {
  /** The popover's id and the radios' name: unique per page. */
  id?: string;
}

const { id = 'theme-menu' } = Astro.props;
---

{/* Shows the theme in use; hidden without JavaScript or popovers. */}
<button
  type="button"
  class="theme-switch"
  popovertarget={id}
  aria-expanded="false"
>
  <span class="sr-only">Theme</span>
  <svg
    class="theme-switch-sun"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
    <path
      d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="square"
    ></path>
  </svg>
  <svg
    class="theme-switch-moon"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
      fill="currentColor"
    ></path>
  </svg>
</button>
<div id={id} class="theme-menu" popover tabindex="-1">
  <fieldset>
    <legend class="label">Theme</legend>
    {THEME_CHOICES.map((choice) => (
      <label class="theme-option">
        <input
          type="radio"
          name={id}
          value={choice.value}
          checked={choice.value === 'system'}
        />
        {choice.label}
      </label>
    ))}
  </fieldset>
</div>

<script>
  import '../scripts/theme-switch';
</script>
