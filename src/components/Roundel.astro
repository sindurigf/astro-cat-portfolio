---
import boxCatRoundel from '../assets/box-cat-roundel.svg?url';

/*
 * The cat in its box, with the box's own ink edge and pink throw. The caller
 * positions it with `class`. alt="": the header names the site.
 */
interface Props {
  class?: string;
  eager?: boolean;
  /* `hero`: on a gold slab edge, sized by --spacing-roundel. */
  variant?: 'page' | 'hero';
}

const { class: className = '', eager = false, variant = 'page' } = Astro.props;

const BOX_CLASS = {
  page: 'size-24 lg:size-32',
  hero: 'size-roundel',
} as const;

/* The file's square size; the box class sets the drawn size. */
const ART_SIZE = 112;
---

<img
  src={boxCatRoundel}
  alt=""
  width={ART_SIZE}
  height={ART_SIZE}
  decoding="async"
  loading={eager ? 'eager' : 'lazy'}
  class:list={['block rotate-3', BOX_CLASS[variant], className]}
/>
