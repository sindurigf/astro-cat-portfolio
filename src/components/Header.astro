---
import {
  CTA,
  HEADER_LINKS,
  HOME_HREF,
  NAV_LINKS,
  ariaCurrent,
} from '../lib/nav';
import { SITE_NAME } from '../lib/site';
import CatMark from './CatMark.astro';
import NavList from './NavList.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import TextSizeButton from './TextSizeButton.astro';
import { TALKS_PATH } from '../lib/paths';

/* A line break is allowed after the first dot, as in `example.<wbr>com`. */
const dot = SITE_NAME.indexOf('.');
const [wordmarkHead, wordmarkTail] =
  dot === -1
    ? [SITE_NAME, undefined]
    : [SITE_NAME.slice(0, dot + 1), SITE_NAME.slice(dot + 1)];

const currentPath = Astro.url.pathname;

/* A slide deck loads no on-demand script, so it has no text size control. */
const sizeControls = !currentPath.startsWith(TALKS_PATH);

const current = (href: string) => ariaCurrent(currentPath, href);
---

{/* Gutter on <header>, not the column, so its content box matches <main> and the footer. */}
<header class="site-header page-gutter sticky top-0 z-50 h-header py-3 bg-background short:static">
  {/* Grid from `lg`, not `md`: between 768 and 1023px the row barely fits and centering wastes slack. */}
  <div class="header-slab flex h-full items-center justify-between lg:grid lg:grid-cols-header">
    {/*
      The desktop nav has no Home item, so this link carries aria-current on `/`.
      aria-label repeats the wordmark exactly (SC 2.5.3): the <wbr> below makes
      Chromium compute "example. com". `justify-self-start` stops it stretching.
    */}
    <a
      href={HOME_HREF}
      aria-label={SITE_NAME}
      aria-current={current(HOME_HREF)}
      class="logo-link flex min-w-0 items-center gap-4 max-xs:gap-2 lg:justify-self-start"
    >
      <span class="logo-tile flex shrink-0 rotate-3">
        <CatMark body={41} class="size-12" eager />
      </span>
      {/*
        Drawn from `md`; below it only the tile shows, which leaves room for the
        Theme, Text Size and Menu bricks at 320px. The link's aria-label names it.
        Untracked below xs; under SC 1.4.12 spacing it breaks after the dot.
      */}
      {/* prettier-ignore */}
      <span class="label min-w-0 text-gold-text max-xs:tracking-normal max-md:sr-only">{wordmarkHead}{wordmarkTail !== undefined && <Fragment><wbr />{wordmarkTail}</Fragment>}</span>
    </a>

    {/* Bricks are the 44px target (SC 2.5.5); styles in buttons-nav.css. */}
    <nav class="hidden md:block lg:justify-self-center" aria-label="Primary">
      {/* The md-to-lg trim (px) lets the row fit; tests/header-fit.spec.ts fails if it overlaps or scrolls. */}
      <NavList
        links={HEADER_LINKS}
        class="header-bricks"
        linkClass="nav-sticker"
        activeClass=""
        restClass=""
      />
    </nav>

    {/*
      The CTA is outside the Primary nav so the nav stays centered; `ml-auto`
      inside the list would push the links off-center by half its width.
    */}
    <div class="header-bricks lg:justify-self-end">
      <ThemeSwitch textSize={sizeControls} />
      {sizeControls && <TextSizeButton />}
      <div class="hidden md:block">
        <a
          href={CTA.href}
          aria-current={current(CTA.href)}
          class="nav-cta flex h-target items-center whitespace-nowrap px-3 lg:px-6"
        >
          {CTA.label}
        </a>
      </div>

      {/*
      The script loads at every width: 400% zoom crosses `md` (SC 1.4.10). The
      name stays "Menu"; aria-expanded carries the state and drives the icon.
    */}
      <div class="mobile-menu md:hidden" data-mobile-menu>
        <button
          type="button"
          class="menu-brick group flex size-target items-center justify-center border-4"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
          aria-label="Menu"
          data-menu-trigger
        >
          <span aria-hidden="true" class="relative block h-4 w-6">
            <span class="absolute left-0 top-0 block h-menu-bar w-6 bg-text forced-colors:bg-button-text group-aria-expanded:top-menu-bar-mid group-aria-expanded:rotate-45" />
            <span class="absolute left-0 top-menu-bar-mid block h-menu-bar w-6 bg-text forced-colors:bg-button-text opacity-100 group-aria-expanded:opacity-0" />
            <span class="absolute left-0 top-menu-bar-end block h-menu-bar w-6 bg-text forced-colors:bg-button-text group-aria-expanded:top-menu-bar-mid group-aria-expanded:-rotate-45" />
          </span>
        </button>

        {/* aria-label, not an sr-only h2, which would precede the page h1. */}
        <dialog
          id="mobile-menu-panel"
          class="mobile-menu-dialog"
          aria-label="Menu"
        >
          <div class="mobile-menu-content">
            {/* Unnamed: "Primary" would duplicate the header nav's landmark name (SC 1.3.1). */}
            <nav>
              <NavList
                links={NAV_LINKS}
                class="flex flex-col items-start gap-6"
                linkClass="nav-sticker nav-sticker-large press-brick"
                activeClass=""
                restClass=""
              />

              <a
                href={CTA.href}
                aria-current={current(CTA.href)}
                class="nav-cta press-brick mt-12 block px-8 py-4 text-center"
              >
                {CTA.label}
              </a>
            </nav>

            <button
              type="button"
              class="btn-secondary press-brick mt-12 w-full"
              data-menu-close
            >
              Close
            </button>
          </div>
        </dialog>
      </div>
    </div>
  </div>
</header>

{/*
  No-JavaScript nav, shown by `@media (scripting: none)`, not <noscript>
  (a WAVE alert). Outside <header>: inside, wrapped links overflow the fixed
  --spacing-header. `md:hidden` avoids two "Primary" navs (tests/no-script.spec.ts).
*/}
<nav
  class="noscript-nav page-gutter edge-b border-border bg-background py-4 md:hidden"
  aria-label="Primary"
>
  <NavList
    links={[...NAV_LINKS, CTA]}
    class="mx-auto flex max-w-page flex-wrap items-center gap-6"
    linkClass="hit-target label block border-4 border-border px-4 py-2"
    activeClass="bg-text text-background"
    restClass="text-text hover:text-cyan"
  />
</nav>

<script>
  import '../scripts/mobile-menu';
  import '../scripts/header-compact';
</script>
