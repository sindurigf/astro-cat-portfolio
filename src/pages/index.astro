---
import { Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../lib/photo-formats';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import CloseRow from '../components/CloseRow.astro';
import Section from '../components/Section.astro';
import HomeDrift from '../components/HomeDrift.astro';
import HomeMeadowBand from '../components/HomeMeadowBand.astro';
import HomePause from '../components/HomePause.astro';
import portrait from '../assets/photos/tabby-duvet.jpg';
import '../styles/components/home.css';
import { BLOG_CATEGORIES, type BlogCategory } from '../content.config';
import {
  cardProps,
  categoryLabel,
  getCategoriesWithPosts,
  getFeaturedPosts,
  getSortedPosts,
} from '../lib/blog';
import { WIDTHS } from '../lib/image-densities';
import { PERSONA_NOTICE_ID, SAMPLE_PERSONA } from '../lib/persona';
import { CATEGORIES, CATEGORY_TILE } from '../lib/categories';
import { packRows, wallClasses } from '../lib/wall';
import { BLOG_PATH, categoryHref } from '../lib/paths';
import {
  JOB_TITLE,
  PERSON_FAMILY_NAME,
  PERSON_GIVEN_NAME,
  PERSON_NAME,
} from '../lib/profiles';

/* Editorial copy belongs to the sample persona; replace it with your own. */

const FEATURED_LIMIT = 3;
const featured = await getFeaturedPosts(FEATURED_LIMIT);
const [newest] = await getSortedPosts();
/* Two columns at most: the lanes beside the fall leave too little room for three. */
const FEATURED_COLUMNS = 2;
/*
 * Measured in the fall's column, which leaves --spacing-home-lane-md each side
 * from `md` and --spacing-home-lane from `xl` (tests/image-size.spec.ts).
 */
const featuredCoverSizes =
  '(min-width: 80rem) min(calc(50vw - 302px), 546px), (min-width: 64rem) calc(50vw - 246px), (min-width: 48rem) calc(100vw - 400px), (min-width: 40rem) calc(100vw - 11rem), calc(100vw - 8rem)';
const featuredWall = wallClasses(
  {
    lg: packRows(
      featured.map(() => 1),
      FEATURED_COLUMNS,
    ),
  },
  featured.length,
);

/* The topic the tagline opens with. */
const LEAD_CATEGORY: BlogCategory = 'open-source';

const withPosts = await getCategoriesWithPosts();

const CATEGORY_CARDS = [
  LEAD_CATEGORY,
  ...BLOG_CATEGORIES.filter((category) => category !== LEAD_CATEGORY),
]
  .filter((category) => withPosts.includes(category))
  .map((category) => ({ category, ...CATEGORIES[category] }));

/* The lead card spans two columns only where the rest then fill whole rows. */
const SM_COLUMNS = 2;
const LG_COLUMNS = 3;
const LEAD_SPAN = 2;
const leadSpansSm = (CATEGORY_CARDS.length - 1) % SM_COLUMNS === 0;
const leadSpansLg =
  CATEGORY_CARDS.length >= LEAD_SPAN &&
  (CATEGORY_CARDS.length - LEAD_SPAN) % LG_COLUMNS === 0;
const spansWith = (leadSpans: boolean) =>
  CATEGORY_CARDS.map((_, index) => (index === 0 && leadSpans ? LEAD_SPAN : 1));
const categoryWall = wallClasses(
  {
    sm: packRows(spansWith(leadSpansSm), SM_COLUMNS),
    lg: packRows(spansWith(leadSpansLg), LG_COLUMNS),
  },
  CATEGORY_CARDS.length,
);

/* The photo's drawn width inside its 4px frame: --size-home-photo from `xl`, -lg from `lg`, the phone size or the column below (tests/image-size.spec.ts). */
const HOME_PHOTO_SIZES =
  '(min-width: 80rem) 29.5rem, (min-width: 64rem) 25.5rem, min(31.5rem, calc(100vw - 5.5rem))';

// TODO(fork): Replace Robin's taglines and numbers with your own, and her text in the page below.
const TAGLINES = ['Reading the Past', 'One Stone at a Time'] as const;
/* Side by side from `sm`, the second climbing (the Step). */
const tagWall = wallClasses({ sm: [[0, 1]] }, TAGLINES.length, {
  short: true,
});

const STATS = [
  {
    value: '1 crew',
    label: 'Whose captain said yes',
  },
  {
    value: '20 years',
    label: 'On the run before that',
  },
] as const;
/* The two stats sit side by side from `sm`, the second climbing (the Step). */
const statWall = wallClasses({ sm: [[0, 1]] }, STATS.length, {
  short: true,
});
---

<BaseLayout
  title={`${PERSON_NAME}, ${JOB_TITLE}`}
  titleSuffix={false}
  description={`${PERSON_NAME}, archaeologist of the Straw Hat Pirates and the last scholar of Ohara. Notes on Poneglyphs, history and life at sea.`}
>
  <div class="gold-column surface-gold home-meadow">
    <div class="home-hero">
      <div class="home-hero-text">
        <h1 id="home-name" class="home-name">
          <span class="block">{PERSON_GIVEN_NAME}</span>{' '}
          <span class="block">{PERSON_FAMILY_NAME}</span>
        </h1>

        <div class="home-photo">
          <div class="aspect-frame aspect-square border-4">
            <Picture
              {...PHOTO_FORMATS}
              src={portrait}
              alt="A tabby cat lying on a white duvet, looking at the camera."
              widths={WIDTHS}
              sizes={HOME_PHOTO_SIZES}
            />
          </div>
        </div>

        <ul
          role="list"
          class:list={[
            'card-block home-tags home-pair grid sm:grid-cols-2',
            tagWall.wall,
          ]}
        >
          {TAGLINES.map((tag, index) => (
            <li class:list={['edge home-tag', tagWall.bricks[index]]}>{tag}</li>
          ))}
        </ul>

        <p class="text-body text-pretty">
          I learned to read Poneglyphs as a child on Ohara. Now I read them with
          the Straw Hat Pirates, wherever we land. This site is where my notes
          live.
        </p>

        {SAMPLE_PERSONA !== null && (
          <p class="text-body text-pretty">
            {SAMPLE_PERSONA.tribute}{' '}
            <a href={`/credits/#${PERSONA_NOTICE_ID}`}>Read the Full Notice</a>.
          </p>
        )}

        <p>
          <a href="/about/" class="btn-gold-secondary">
            Learn More About Me
          </a>
        </p>

        <div class="home-hero-row">
          <ul
            role="list"
            class:list={[
              'card-block home-pair grid sm:grid-cols-2',
              statWall.wall,
            ]}
          >
            {STATS.map((stat, index) => (
              <li
                class:list={[
                  'flex min-w-0 flex-col edge p-card-tight',
                  statWall.bricks[index],
                ]}
              >
                <span class="text-display font-black">{stat.value}</span>
                <span class="label mt-2">{stat.label}</span>
              </li>
            ))}
          </ul>
          <HomePause />
        </div>
      </div>
    </div>

    <HomeMeadowBand />
  </div>

  <div class="home-fall">
    <HomeDrift />
    {CATEGORY_CARDS.length > 0 && (
      <Section title="What I Write About">
        <ul
          role="list"
          class:list={[
            'card-block grid gap-grid sm:grid-cols-2 lg:grid-cols-3',
            categoryWall.wall,
          ]}
        >
          {CATEGORY_CARDS.map((card, index) => (
            <li
              class:list={[
                'card flex flex-col',
                categoryWall.bricks[index],
                index === 0 && leadSpansSm && 'sm:col-span-2',
                index === 0 && leadSpansLg && 'lg:col-span-2',
              ]}
            >
              <span
                aria-hidden="true"
                class:list={[
                  'flex size-16 -rotate-3 items-center justify-center edge text-section-number font-black leading-none',
                  CATEGORY_TILE,
                ]}
              >
                {card.glyph}
              </span>

              <h3 class="card-title mt-8">
                <a href={categoryHref(card.category)} class="card-link">
                  {categoryLabel(card.category)}
                  <span class="sr-only">&nbsp;Posts</span>
                </a>
              </h3>

              <p class="mt-4 text-body text-pretty">{card.teaser}</p>
            </li>
          ))}
        </ul>

        <p class="mt-head">
          <a href={BLOG_PATH} class="btn-secondary">
            View All Posts
          </a>
        </p>
      </Section>
    )}

    {featured.length > 0 && (
      <Section title="Featured Posts">
        <ul
          role="list"
          class:list={[
            'card-block grid gap-grid lg:grid-cols-2',
            featuredWall.wall,
          ]}
        >
          {featured.map((post, index) => (
            <li class:list={['flex min-w-0', featuredWall.bricks[index]]}>
              <BlogCard
                {...cardProps(post)}
                coverSizes={featuredCoverSizes}
                describeCover={post.id === newest?.id}
                headingLevel={3}
                class="w-full"
              />
            </li>
          ))}
        </ul>
      </Section>
    )}

    <CloseRow
      eyebrow="Next"
      readHref="/career/"
      readLabel="Career"
      actionHref="/contact/"
      actionLabel="Get in Touch"
    />
  </div>
</BaseLayout>

<script>
  import '../scripts/card-click';
  import '../scripts/home-motion';
</script>
