---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatMark from '../components/CatMark.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/components/signpost.css';
import { sectionsOf, signpostPages } from '../lib/signpost-pages';
import { sitePages } from '../lib/site-pages';

/*
 * Served with status 404 via `not_found_handling: "404-page"` in wrangler.jsonc.
 * noCanonical: it answers every dead URL. noindex: /404 itself is a route that
 * answers 200, and would otherwise be indexable.
 */

/* CSS px: the tile body CatMark draws 72px tall, --size-crossroads-guide. */
const GUIDE_BODY = 63;

const pages = signpostPages(await sitePages());
/* `<` escaped, so no title can close the data block. */
const pagesJson = JSON.stringify(pages).replace(/</g, '\\u003c');
const sections = sectionsOf(pages);

/* Carroll's text, Project Gutenberg #11, chapter VI. */
const CAT_LINE =
  '“That depends a good deal on where you want to get to,” said the Cat.';
---

<BaseLayout
  title="Page Not Found"
  description="That address does not lead anywhere on this site. Ask the Cat for a page that does."
  noCanonical
  noindex
>
  <PageHero
    title="Which Way From Here?"
    titleSize="h2"
    hiddenPrefix="Page Not Found:"
    slab="none"
  >
    <span slot="eyebrow" class="badge">
      Page Not Found
    </span>

    <p slot="slab" class="standfirst">
      This page does not exist, but the Cat knows the way. Nothing is broken on
      your end. If a link on this site brought you here,{' '}
      <a href="/contact/">tell me about the broken link</a>.
    </p>

    {/* Without JavaScript the signs are links; src/scripts/signpost.ts makes them choose a way. */}
    <div id="crossroads" slot="slab" class="crossroads mt-head">
      <p class="crossroads-cat">{CAT_LINE}</p>
      <div class="crossroads-map">
        <div class="crossroads-column">
          <div id="crossroads-signs-label" class="crossroads-heading label">
            Sections
          </div>
          <ul
            role="list"
            class="crossroads-signs"
            aria-labelledby="crossroads-signs-label"
          >
            {sections.map((section) => (
              <li>
                <a
                  href={section.path}
                  class="crossroads-sign label"
                  data-path={section.path}
                >
                  {section.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="crossroads-pole" aria-hidden="true">
          <span class="crossroads-guide">
            <CatMark body={GUIDE_BODY} eager />
          </span>
        </div>
        <div class="crossroads-column" data-pending>
          <div
            id="crossroads-pages-label"
            class="crossroads-heading label"
          ></div>
        </div>
      </div>
      <p class="sr-only" aria-live="polite"></p>
      <script
        is:inline
        type="application/json"
        id="signpost-pages"
        set:html={pagesJson}
      />
    </div>
  </PageHero>
</BaseLayout>

<script>
  import '../scripts/signpost';
</script>
