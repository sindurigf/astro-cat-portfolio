---
import Abbr from '../../components/Abbr.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BrandFrame from '../../components/brand/BrandFrame.astro';
import BrandSection from '../../components/brand/BrandSection.astro';
import ColorBlocks from '../../components/brand/ColorBlocks.astro';
import Grounds from '../../components/brand/Grounds.astro';
import Pairings from '../../components/brand/Pairings.astro';
import TypeScale from '../../components/brand/TypeScale.astro';
import SpacingSteps from '../../components/brand/SpacingSteps.astro';
import EdgesAndShadows from '../../components/brand/EdgesAndShadows.astro';
import MotionRules from '../../components/brand/MotionRules.astro';
import Actions from '../../components/brand/Actions.astro';
import Labels from '../../components/brand/Labels.astro';
import Controls from '../../components/brand/Controls.astro';
import Heroes from '../../components/brand/Heroes.astro';
import Navigation from '../../components/brand/Navigation.astro';
import Cards from '../../components/brand/Cards.astro';
import Forms from '../../components/brand/Forms.astro';
import Photos from '../../components/brand/Photos.astro';
import Text from '../../components/brand/Text.astro';
import Standard from '../../components/brand/Standard.astro';
import UseTemplate from '../../components/brand/UseTemplate.astro';
import {
  DEMO_URL,
  HAS_LINKS,
  SOURCE_URL,
  USE_TEMPLATE_URL,
} from '../../components/brand/links';
import { SITE_NAME } from '../../lib/site';
import { TEXT_TARGET_RATIO } from '../../lib/brand-blocks';
import { BRAND_SECTIONS } from '../../lib/brand-sections';

const PARTS = {
  grounds: Grounds,
  color: ColorBlocks,
  contrast: Pairings,
  type: TypeScale,
  spacing: SpacingSteps,
  'borders-and-shadows': EdgesAndShadows,
  motion: MotionRules,
  'buttons-and-links': Actions,
  'chips-and-labels': Labels,
  controls: Controls,
  heroes: Heroes,
  navigation: Navigation,
  cards: Cards,
  forms: Forms,
  photos: Photos,
  text: Text,
  accessibility: Standard,
  template: UseTemplate,
} as const;

const sections = BRAND_SECTIONS.map((section) => {
  const Parts = (PARTS as Record<string, (typeof PARTS)[keyof typeof PARTS]>)[
    section.slug
  ];
  if (!Parts) {
    throw new Error(
      `/brand: the section ${section.slug} has no parts in src/pages/brand/index.astro`,
    );
  }
  return { section, Parts };
});
---

<BaseLayout
  title="Brand"
  description={`The design system behind ${SITE_NAME}: color, contrast, type, spacing, shadows, controls and motion, drawn from the site's own CSS.`}
>
  <PageHero title="Brand">
    <p class="standfirst">
      The design system behind this site, drawn from its own{' '}
      <Abbr short="CSS" long="Cascading Style Sheets" after="." /> It aims for
      the <Abbr short="WCAG" long="Web Content Accessibility Guidelines" /> 2.2
      at Level{' '}
      <Abbr short="AA" long="the middle of WCAG's three levels" after="," /> and
      at Level <Abbr short="AAA" long="the highest of WCAG's three levels" />{' '}
      for text contrast.
    </p>
    {HAS_LINKS && (
      <p class="mt-8 flex flex-wrap gap-6">
        {USE_TEMPLATE_URL && (
          <a href={USE_TEMPLATE_URL} class="btn-gold-primary">
            Use This Design
          </a>
        )}
        {SOURCE_URL && (
          <a href={SOURCE_URL} class="btn-gold-secondary">
            View the Source
          </a>
        )}
        {DEMO_URL && (
          <a href={DEMO_URL} class="btn-gold-secondary">
            See the Demo
          </a>
        )}
      </p>
    )}
  </PageHero>

  <div class="band pt-section">
    <div class="mx-auto max-w-page">
      <dl class="fact-strip grid gap-0 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <dt class="label text-gold">Text contrast</dt>
          <dd class="mt-4 text-text">{TEXT_TARGET_RATIO}:1 or more</dd>
        </div>
        <div class="lg:col-span-3">
          <dt class="label text-gold">Spacing</dt>
          <dd class="mt-4 text-text">A 4px base</dd>
        </div>
        <div class="lg:col-span-3">
          <dt class="label text-gold">Type</dt>
          <dd class="mt-4 text-text">Lexend at 400 and 900</dd>
        </div>
        <div class="lg:col-span-3">
          <dt class="label text-gold">Sections</dt>
          <dd class="mt-4 text-text">
            {BRAND_SECTIONS.length}, each shown dark and light
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <BrandFrame>
    {sections.map(({ section, Parts }) => (
      <BrandSection section={section}>
        <Parts />
      </BrandSection>
    ))}
  </BrandFrame>
</BaseLayout>
