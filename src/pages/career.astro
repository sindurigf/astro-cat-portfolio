---
import { statSync } from 'node:fs';
import { join } from 'node:path';

import BaseLayout from '../layouts/BaseLayout.astro';
import CloseRow from '../components/CloseRow.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { closeRowLinks } from '../lib/blog';
import { CV_PATH, PERSON_NAME } from '../lib/profiles';

/* The sample persona's copy; keep it in step with the CV when one is published. */
const PUBLIC_DIR = 'public';
const BYTES_PER_KB = 1024;

/* From cwd, not import.meta.url: this runs bundled in dist/.prerender/chunks/. */
const cvKb = (path: string): number =>
  Math.round(
    statSync(join(process.cwd(), PUBLIC_DIR, path)).size / BYTES_PER_KB,
  );

const EXPERIENCE = [
  {
    dates: 'Arabasta–Present',
    where: 'The Straw Hat Pirates',
    title: "Ship's Archaeologist",
    current: true,
    points: [
      'Read the Poneglyphs the crew finds, and record what each one says.',
      'Study the records and ruins on every island where we land.',
      'Asked to join after Arabasta, and the captain said yes.',
    ],
  },
  {
    dates: 'Before Arabasta',
    where: 'Baroque Works',
    title: 'Vice President, Miss All Sunday',
    current: false,
    points: [
      'Worked under the codename Miss All Sunday.',
      "Partner of the agency's leader, Crocodile, known inside it as Mr. 0.",
    ],
  },
  {
    dates: 'Age 8–28',
    where: 'On the Run',
    title: 'Independent Archaeologist',
    current: false,
    points: [
      'Wanted by the World Government from the age of eight, with a first bounty of 79,000,000 berries.',
      'Kept reading Poneglyphs wherever I could find them, for about twenty years.',
    ],
  },
] as const;

const SKILLS = [
  'Reading Poneglyphs',
  'Archaeology',
  'The Void Century',
  'Hana Hana no Mi',
  'Working Undercover',
] as const;

/* `honor` renders in `lang="la"` (SC 3.1.2). */
const EDUCATION = [
  {
    award: 'Archaeology Exam',
    detail: 'Passed at the age of eight, on Ohara.',
  },
  {
    award: 'Library of Ohara',
    detail:
      'Read in the library inside the Tree of Knowledge, with the permission of its director, Professor Clover.',
  },
  {
    award: 'Poneglyphs',
    detail: 'Learned to read their ancient script as a child.',
  },
] as const;

const LANGUAGES = [
  { language: 'The Poneglyph Script', level: 'Reading' },
] as const;

const OPEN_SOURCE = [
  {
    award: 'The Scholars of Ohara',
    detail:
      'Studied the Poneglyphs together, in the library in the Tree of Knowledge.',
  },
  {
    award: 'The Straw Hat Pirates',
    detail: 'Archaeologist of the crew since Arabasta.',
  },
  {
    award: 'Baroque Works',
    detail: 'Vice president, under the codename Miss All Sunday.',
  },
  {
    award: 'Professor Clover',
    detail:
      'Director of the Library of Ohara, who let me read there as a child.',
  },
] as const;
const closeRow = await closeRowLinks({
  href: '/about/',
  label: 'Learn More about Me',
});
---

<BaseLayout
  title="Career"
  description={`${PERSON_NAME}: work history, education and skills, from the Library of Ohara to the Straw Hat Pirates.`}
>
  <PageHero title="Career">
    <p class="standfirst">
      <span class="block">Reading the Poneglyphs.</span>{' '}
      <span class="block">Studying the Void Century.</span>{' '}
      <span class="block">Sailing with the Straw Hats.</span>
    </p>

    {/* Size, not only color, carries the hierarchy: forced colors flattens color. */}
    <p class="mt-4 text-body text-gold-muted">
      Archaeology, history and a great deal of careful reading.
    </p>

    {/* No `download` attribute: the browser's viewer is the more accessible default. */}
    <p class="actions mt-head">
      {CV_PATH !== null && (
        <a href={CV_PATH} class="btn-gold-primary">
          Download my CV (PDF, {cvKb(CV_PATH)} KB)
        </a>
      )}
      <a
        href="/contact/"
        class:list={[
          CV_PATH === null ? 'btn-gold-primary' : 'btn-gold-secondary',
        ]}
      >
        Get in Touch
      </a>
    </p>
  </PageHero>

  <Section title="Summary" panel>
    <p slot="lead" class="lead max-w-3xl">
      I am the archaeologist of the Straw Hat Pirates. I read the Poneglyphs,
      stones carved in a script that few people alive can read, and I study the
      Void Century, the hundred years the World Government forbids anyone to
      research.
    </p>
    <p class="max-w-measure text-body text-text text-pretty">
      I started young: I passed the archaeology exam at eight, on Ohara.
    </p>
  </Section>

  <Section title="Work Experience">
    <ol class="card-block flex flex-col gap-grid">
      {
        /* Title first, so heading navigation lands before the employer. */
        EXPERIENCE.map((role) => (
          <li
            class:list={[
              'card grid gap-8 lg:grid-cols-12',
              role.current && 'card-solid',
            ]}
          >
            <div class="flex min-w-0 flex-col items-start gap-4 lg:col-span-12">
              {role.current && <span class="badge">Current</span>}
              <h3 class="card-title">{role.title}</h3>
            </div>

            {/* No `text-*` inside the solid block: a utility beats its rule (tests/solid-block.spec.ts). */}
            <p class="flex min-w-0 flex-col gap-2 lg:col-span-3">
              <span class:list={['label', !role.current && 'text-subtle']}>
                {role.dates}
              </span>
              <span class:list={['label', !role.current && 'text-subtle']}>
                {role.where}
              </span>
            </p>

            <ul class="bullet-list min-w-0 lg:col-span-9">
              {role.points.map((point) => (
                <li class="mt-3 text-body text-pretty first:mt-0">{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section title="Skills and Education">
    <div class="grid gap-grid lg:grid-cols-2">
      <div class="card">
        <h3 class="card-title">Education</h3>
        <ul class="mt-8 flex flex-col gap-4">
          {EDUCATION.map((item) => (
            <li class="text-body text-text text-pretty">
              <strong class="font-black text-text">{item.award}</strong>
              {': '}
              {item.detail}
              {'honor' in item ? (
                <>
                  {' '}
                  <span lang="la">{item.honor}</span>.
                </>
              ) : null}
            </li>
          ))}
        </ul>
      </div>

      <div class="flex min-w-0 flex-col gap-grid">
        <div class="card">
          <h3 class="card-title">Skills</h3>
          <ul class="mt-8 flex flex-wrap gap-3">
            {SKILLS.map((skill) => (
              <li class="badge">{skill}</li>
            ))}
          </ul>
        </div>

        <div class="card">
          <h3 class="card-title">Languages</h3>
          <ul class="mt-8 flex flex-col gap-4">
            {LANGUAGES.map((item) => (
              <li class="text-body text-text">
                <strong class="font-black text-text">{item.language}</strong>
                {': '}
                {item.level}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section title="Open Source" surface="gold" class="gold-column">
    <div class="grid gap-grid lg:grid-cols-12 lg:items-start">
      <p class="lead mt-0 lg:col-span-5">
        The scholars of Ohara studied history together, and lost everything for
        it. I still believe history belongs to everyone.
      </p>
      <dl class="grid gap-grid sm:grid-cols-2 lg:col-span-7">
        {OPEN_SOURCE.map((item) => (
          <div class="card">
            {/* `text-gold` and `text-text` fail SC 1.4.3 on this ground. */}
            <dt class="label text-gold-muted">{item.award}</dt>
            <dd class="mt-4 text-body text-pretty">{item.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <CloseRow {...closeRow} />
</BaseLayout>
