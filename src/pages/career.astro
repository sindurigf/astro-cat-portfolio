---
import { statSync } from 'node:fs';
import { join } from 'node:path';

import BaseLayout from '../layouts/BaseLayout.astro';
import CloseRow from '../components/CloseRow.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { closeRowLinks } from '../lib/blog';
import { CV_PATH, PERSON_NAME } from '../lib/profiles';

/* The sample persona's copy; keep it in step with the CV when one is published. */
const PUBLIC_DIR = 'public';
const BYTES_PER_KB = 1024;

/* From cwd, not import.meta.url: this runs bundled in dist/.prerender/chunks/. */
const cvKb = (path: string): number =>
  Math.round(
    statSync(join(process.cwd(), PUBLIC_DIR, path)).size / BYTES_PER_KB,
  );

const EXPERIENCE = [
  {
    dates: 'Jan 2026–Present',
    where: 'The Straw Hat crew',
    title: "Ship's archaeologist",
    current: true,
    points: [
      'Read and translate the inscriptions we find, and record each one with a drawing, a place and a date.',
      "Keep the ship's library and charts in order, so anyone aboard can find what they need.",
      'Brief the crew on the history and customs of each island before we land.',
    ],
  },
  {
    dates: 'Jun 2023–Nov 2025',
    where: 'Independent research',
    title: 'Freelance historian',
    current: false,
    points: [
      'Studied ruins and archives on islands across four seas, often alone and often in a hurry.',
      'Built a personal index of scripts and symbols, and the places they appear.',
      'Wrote field reports for museums and private collections.',
      'Repaired and catalogued damaged books and maps.',
      'Taught reading and writing to children on the islands where I stayed.',
      'Gave my first public talk in 2025.',
    ],
  },
  {
    dates: 'Jan 2021–May 2023',
    where: 'Example Expedition Society',
    title: 'Field researcher & expedition planner',
    current: false,
    points: [
      'Planned routes, supplies and permits for small research expeditions.',
      'Surveyed sites and photographed carvings before weather and time could wear them away.',
      'Wrote plain summaries, so the people who funded each trip could see what it found and what was still unknown.',
    ],
  },
] as const;

const SKILLS = [
  'Ancient scripts and translation',
  'Field survey',
  'Archives and cataloguing',
  'Book and map repair',
  'Research writing',
  'Teaching and public talks',
] as const;

/* `honour` renders in `lang="la"` (SC 3.1.2). */
const EDUCATION = [
  {
    award: 'Advanced Archaeology',
    detail: 'Ohara Library, 2020.',
    honour: 'Summa cum laude',
  },
  {
    award: 'Reading Ancient Scripts',
    detail:
      'Ohara Library, 2019. Inscriptions, ciphers, dead languages, translation, dating and record keeping.',
    honour: 'Summa cum laude',
  },
  { award: 'Underwater Survey', detail: 'Short course, 2019.' },
  {
    award: 'History, Master of Arts',
    detail: 'Example University, 2006–2009.',
  },
  {
    award: 'Archaeology, Bachelor of Arts',
    detail: 'Example College, 2001–2005.',
  },
] as const;

const LANGUAGES = [
  { language: 'English', level: 'Fluent' },
  { language: 'Latin', level: 'Reading knowledge' },
] as const;

const OPEN_SOURCE = [
  {
    award: 'Open Archives Award',
    detail: 'Public records category, 2025.',
  },
  {
    award: 'Example Association',
    detail: 'Board member for shared research archives since 2026.',
  },
  {
    award: 'Example Community',
    detail: 'Volunteer translator for an open library of old texts.',
  },
  {
    award: 'Event organising',
    detail:
      'Started a reading circle in 2023, then a yearly meeting for island historians.',
  },
] as const;
const closeRow = await closeRowLinks({
  href: '/about/',
  label: 'Learn more about me',
});
---

<BaseLayout
  title="Career"
  description={`${PERSON_NAME}: work history, education and skills, from field research to translating old scripts and keeping records that last.`}
>
  <PageHero title="Career">
    <p class="standfirst">
      <span class="block">Reading old scripts.</span>{' '}
      <span class="block">Keeping careful records.</span>{' '}
      <span class="block">Sharing what I find.</span>
    </p>

    {/* Size, not only colour, carries the hierarchy: forced colours flattens colour. */}
    <p class="mt-4 text-body text-gold-muted">
      Archaeology, history and a great deal of careful reading.
    </p>

    {/* No `download` attribute: the browser's viewer is the more accessible default. */}
    <p class="actions mt-head">
      {CV_PATH !== null && (
        <a href={CV_PATH} class="btn-gold-primary">
          Download my CV (PDF, {cvKb(CV_PATH)} KB)
        </a>
      )}
      <a
        href="/contact/"
        class:list={[
          CV_PATH === null ? 'btn-gold-primary' : 'btn-gold-secondary',
        ]}
      >
        Get in touch
      </a>
    </p>
  </PageHero>

  <Section title="Summary" panel>
    <p slot="lead" class="lead max-w-3xl">
      I am an archaeologist who reads what older people carved and wrote, and
      explains it to the people living now. I work in the field, in archives and
      on deck: surveying sites, translating inscriptions and keeping records
      that someone else can pick up after me.
    </p>
    <p class="max-w-measure text-body text-text text-pretty">
      I like slow, careful work and plain explanations. If a find cannot be
      checked, I say so.
    </p>
  </Section>

  <Section title="Work experience">
    <ol class="card-block flex flex-col gap-grid">
      {
        /* Title first, so heading navigation lands before the employer. */
        EXPERIENCE.map((role) => (
          <li
            class:list={[
              'card grid gap-8 lg:grid-cols-12',
              role.current && 'card-solid',
            ]}
          >
            <div class="flex min-w-0 flex-col items-start gap-4 lg:col-span-12">
              {role.current && <span class="badge">Current</span>}
              <h3 class="card-title">{role.title}</h3>
            </div>

            {/* No `text-*` inside the solid block: a utility beats its rule (tests/solid-block.spec.ts). */}
            <p class="flex min-w-0 flex-col gap-2 lg:col-span-3">
              <span class:list={['label', !role.current && 'text-subtle']}>
                {role.dates}
              </span>
              <span class:list={['label', !role.current && 'text-subtle']}>
                {role.where}
              </span>
            </p>

            <ul class="bullet-list min-w-0 lg:col-span-9">
              {role.points.map((point) => (
                <li class="mt-3 text-body text-pretty first:mt-0">{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section title="Skills and education">
    <div class="grid gap-grid lg:grid-cols-2">
      <div class="card">
        <h3 class="card-title">Education</h3>
        <ul class="mt-8 flex flex-col gap-4">
          {EDUCATION.map((item) => (
            <li class="text-body text-text text-pretty">
              <strong class="font-black text-text">{item.award}</strong>
              {': '}
              {item.detail}
              {'honour' in item ? (
                <>
                  {' '}
                  <span lang="la">{item.honour}</span>.
                </>
              ) : null}
            </li>
          ))}
        </ul>
      </div>

      <div class="flex min-w-0 flex-col gap-grid">
        <div class="card">
          <h3 class="card-title">Skills</h3>
          <ul class="mt-8 flex flex-wrap gap-3">
            {SKILLS.map((skill) => (
              <li class="badge">{skill}</li>
            ))}
          </ul>
        </div>

        <div class="card">
          <h3 class="card-title">Languages</h3>
          <ul class="mt-8 flex flex-col gap-4">
            {LANGUAGES.map((item) => (
              <li class="text-body text-text">
                <strong class="font-black text-text">{item.language}</strong>
                {': '}
                {item.level}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section title="Open source" surface="gold" class="gold-column">
    <div class="grid gap-grid lg:grid-cols-12 lg:items-start">
      <p class="lead mt-0 lg:col-span-5">
        I share my notes, translations and indexes, so other researchers do not
        start from nothing. Knowledge kept by one person is easy to lose.
      </p>
      <dl class="grid gap-grid sm:grid-cols-2 lg:col-span-7">
        {OPEN_SOURCE.map((item) => (
          <div class="card">
            {/* `text-gold` and `text-text` fail SC 1.4.3 on this ground. */}
            <dt class="label text-gold-muted">{item.award}</dt>
            <dd class="mt-4 text-body text-pretty">{item.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <CloseRow {...closeRow} />
</BaseLayout>
