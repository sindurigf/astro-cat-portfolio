---
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkSlide from '../../components/TalkSlide.astro';
import DeckBar from '../../components/DeckBar.astro';
import { talkDecks } from '../../lib/talk-deck';
import { getSortedPosts } from '../../lib/blog';
import { postHref } from '../../lib/paths';

/*
 * Every slide is in the HTML; without JavaScript, and below `lg`, the page is a
 * plain document of stacked slides.
 * Slides are h2, not h3 under a part h2: shown one at a time, a part heading
 * would sit on no slide, so DeckBar names the part instead.
 */

/* A deck's post shares its slug; a deck with none links nowhere. */
export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  return [...(await talkDecks())].map(([deck, slides]) => ({
    params: { deck },
    props: { slides, post: posts.find((post) => post.id === deck) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { slides, post } = Astro.props;
const cover = slides[0]?.slide;
const description = cover?.data.info;
if (!cover || description === undefined) {
  throw new Error('A deck needs a cover slide with info: (talk-loader.ts).');
}

const PUBLIC_DIR = 'public';
const BYTES_PER_KB = 1024;
/* npm run publish:talk writes it; from cwd, as career.astro reads the CV. */
const pdfHref = `/talks/${cover.data.deck}.pdf`;
const pdfFile = join(process.cwd(), PUBLIC_DIR, pdfHref);
const pdfKb = existsSync(pdfFile)
  ? Math.round(statSync(pdfFile).size / BYTES_PER_KB)
  : undefined;
---

<BaseLayout title={`${cover.data.title}, the Slides`} description={description}>
  <div class="deck" data-deck={cover.data.deck}>
    {/* No `download` attribute and no new window: the browser's viewer opens in place (SC 3.2.5). */}
    <div class="deck-narrow card">
      <p class="text-body">
        The slideshow needs a wider screen.{' '}
        {pdfKb === undefined
          ? 'Every slide is below.'
          : 'Download the PDF, or read every slide below.'}
      </p>
      {pdfKb !== undefined && (
        <p class="actions mt-6">
          <a href={pdfHref} class="btn-primary">
            Download the Slides (PDF, {pdfKb} KB)
          </a>
        </p>
      )}
    </div>
    <DeckBar total={slides.length} />
    <div class="deck-stage">
      {slides.map(({ slide, part }) => (
        <TalkSlide slide={slide} part={part} />
      ))}
    </div>
  </div>
  {post && (
    <p class="mx-auto max-w-page pb-section text-body text-text print:hidden">
      This talk is also a post:{' '}
      <a href={postHref(post.id)}>{post.data.title}</a>.
    </p>
  )}
</BaseLayout>

<script>
  import '../../scripts/slideshow';
</script>
