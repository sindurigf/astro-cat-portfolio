---
import ProseScrollFit from '../../components/ProseScrollFit.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import PostFolds from '../../components/PostFolds.astro';
import { hasFoldMarkup } from '../../lib/post-folds';
import { hasCodeBlock, hasTable } from '../../lib/code-blocks';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { formatPostDate, isoDateTime } from '../../lib/post-date';
import { isoDate } from '../../lib/time';
import { postTrail } from '../../lib/breadcrumbs';
import { markdownSourcePath, tagHref } from '../../lib/paths';
import { Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../../lib/photo-formats';
import { HERO_PHOTO_SIZES, WIDTHS } from '../../lib/image-densities';
import { photoSize } from '../../lib/photo-size';
import { PHOTOGRAPHERS, PHOTO_CREDIT_PREFIX } from '../../lib/credits';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
/* After BaseLayout, so global.css declares the layer order first. */
import '../../styles/components/code-block.css';
import '../../styles/components/post-folds.css';
import { tagLabel } from '../../lib/blog';
import PersonaSources from '../../components/PersonaSources.astro';
import { PERSONA_SOURCES_ID, SAMPLE_PERSONA } from '../../lib/persona';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content, headings } = await render(post);
if (post.rendered?.html === undefined) {
  throw new Error(`${post.id} has no rendered HTML to look for folds in.`);
}
const foldInPost = hasFoldMarkup(post.rendered.html);
const codeInPost = hasCodeBlock(post.body ?? '');
const scrollerInPost = codeInPost || hasTable(post.body ?? '');

const {
  title,
  date,
  category,
  tags,
  teaser,
  cover,
  coverAlt,
  coverCredit,
  readingTime,
  placeholder,
  updated,
  personaSources,
} = post.data;

const sources = personaSources ? (SAMPLE_PERSONA?.sources ?? []) : [];

const CONTENTS_DEPTH = 2;
const contents = [
  ...headings.filter((heading) => heading.depth === CONTENTS_DEPTH),
  ...(sources.length > 0
    ? [{ depth: CONTENTS_DEPTH, slug: PERSONA_SOURCES_ID, text: 'Sources' }]
    : []),
];

const formattedDate = formatPostDate(date);

const coverSize = await photoSize(cover);
const coverCreditHref =
  coverCredit && Object.hasOwn(PHOTOGRAPHERS, coverCredit)
    ? PHOTOGRAPHERS[coverCredit as keyof typeof PHOTOGRAPHERS]
    : undefined;
const machineDate = isoDate(date);
const trail = postTrail(category, title);

/* Placeholders get no BlogPosting, plus noindex and no sitemap entry (src/lib/sitemap-filter.ts). */
const article = placeholder
  ? undefined
  : {
      headline: title,
      datePublished: isoDateTime(date),
      ...(updated ? { dateModified: isoDateTime(updated) } : {}),
      keywords: tags.map(tagLabel),
    };
---

<BaseLayout
  title={post.data.seoTitle ?? title}
  description={post.data.seoDescription ?? teaser}
  {...(article ? { article } : {})}
  trail={trail}
  {...(placeholder ? {} : { markdownSource: markdownSourcePath(post.id) })}
  noindex={placeholder}
>
  {/*
    Not a PageHero: the title uses the article scale `--text-post-title`, and
    tests/page-hero.spec.ts excludes posts. The crumbs use tone="gold" because
    `text-gold` fails SC 1.4.3 on this ground.
  */}
  <article>
    <section class="post-slab band surface-gold gold-column relative isolate">
      <header class="mx-auto max-w-page lg:grid lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-12 lg:row-start-1">
          <Breadcrumbs crumbs={trail.crumbs} tone="gold" />
        </div>
        {/* PageHero's photo layout: text in the left half, the cover beside it. */}
        <div class="lg:col-span-6 lg:row-start-2 lg:self-center">
          <h1 class="text-post-title post-title text-gold-text">{title}</h1>
          <div class="mt-6">
            <p class="text-post-teaser font-normal text-pretty">{teaser}</p>
            <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-label text-gold-muted">
              <time datetime={machineDate}>{formattedDate}</time>
              {readingTime ? <span>{readingTime} minute read</span> : null}
              {/* Here, not under the photo: the photo hangs below the slab, off the gold ground. */}
              {coverCredit && (
                <span data-cover-credit>
                  {PHOTO_CREDIT_PREFIX}
                  {coverCreditHref ? (
                    <a href={coverCreditHref}>{coverCredit}</a>
                  ) : (
                    coverCredit
                  )}
                </span>
              )}
            </p>
          </div>
        </div>
        <figure class="hero-photo mt-12 max-w-sm lg:col-span-5 lg:col-start-8 lg:row-start-2 lg:mt-0 lg:max-w-none lg:self-end">
          <div class="aspect-frame border-4 border-gold-text shadow-hard-pink-4">
            <svg
              class="aspect-sizer"
              viewBox={`0 0 ${coverSize.width} ${coverSize.height}`}
              aria-hidden="true"
              focusable="false"
            />
            <Picture
              {...PHOTO_FORMATS}
              src={cover}
              alt={coverAlt}
              width={coverSize.width}
              height={coverSize.height}
              widths={WIDTHS}
              sizes={HERO_PHOTO_SIZES}
              priority
              class="text-body text-text"
            />
          </div>
        </figure>
      </header>
    </section>

    <div class="band py-section">
      <div class="post-layout mx-auto max-w-page">
        {contents.length > 0 ? (
          <nav aria-labelledby="post-contents" class="post-contents">
            {/*
            Opened from `xl` by src/scripts/post-contents.ts. The summary is
            not a heading: it names the landmark, and an h2 here would precede
            the article's first section in the outline.
          */}
            <details data-post-contents>
              <summary id="post-contents" class="post-contents-summary">
                <span>In This Post</span>
                <span class="post-contents-marker" aria-hidden="true" />
              </summary>
              <ol role="list">
                {contents.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="block px-card-tight py-3 text-contents font-normal text-text"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        ) : null}

        <div class="prose">
          <Content />
          {scrollerInPost && <ProseScrollFit />}
          {codeInPost && <CodeCopy />}
          {foldInPost && <PostFolds />}
          {sources.length > 0 && (
            <>
              <h2 id={PERSONA_SOURCES_ID}>Sources</h2>
              <PersonaSources sources={sources} />
            </>
          )}
        </div>

        {tags.length > 0 ? (
          <nav aria-labelledby="post-tags" class="edge-t border-border pt-8">
            <span id="post-tags" class="label block text-subtle">
              Tags
            </span>
            <ul role="list" class="mt-4 flex flex-wrap gap-6">
              {tags.map((tag, index) => (
                <li>
                  <a
                    href={tagHref(tag)}
                    class:list={[
                      'chip chip-sticker',
                      index % 2 ? 'rotate-3' : '-rotate-3',
                    ]}
                  >
                    {tagLabel(tag)}
                    <span class="sr-only">&nbsp;tag</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null}
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/post-contents';
</script>
