---
import { SITE_NAME } from '../../../../lib/site';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { blogTrail } from '../../../../lib/breadcrumbs';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import BlogListing from '../../../../components/BlogListing.astro';
import { getPostsByTag, headingLabel, tagLabel } from '../../../../lib/blog';
import { tagFeedPath } from '../../../../lib/paths';
import { tagFeedTitle } from '../../../../lib/feed';

/*
 * Only tags in use get a route. noindex and out of the sitemap: most tags hold
 * one post, so the page adds nothing to search. Not paginated, as categories.
 */
export const getStaticPaths = (async () => {
  const byTag = await getPostsByTag();

  return [...byTag].map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag, posts } = Astro.props;

const label = tagLabel(tag);
const trail = blogTrail(label);
---

<BaseLayout
  title={`Posts Tagged ${label}`}
  description={`Posts tagged ${label} on ${SITE_NAME}, newest first.`}
  noindex
  feed={{ title: tagFeedTitle(tag), href: tagFeedPath(tag) }}
  trail={trail}
>
  {/*
    An h1 sized text-h2: a long tag at text-h1's floor overflows the narrowest
    box (SC 1.4.10). tests/reflow.spec.ts fails on a tag that overflows.
  */}
  <PageHero title={headingLabel(label)} titleSize="h2" slab="none">
    <Breadcrumbs slot="eyebrow" crumbs={trail.crumbs} />
  </PageHero>

  <div class="mx-auto max-w-page py-section">
    <BlogListing
      posts={posts}
      filter={{ kind: 'tag', tag }}
      currentPage={1}
      totalPages={1}
    />
  </div>
</BaseLayout>
