---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import PageHero from '../../components/PageHero.astro';
import { env } from 'cloudflare:workers';
import { rateLimitKey } from '../../lib/rate-limit-key';
import { readCappedForm } from '../../lib/request-body';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../../lib/contact';
import {
  FORM_MEDIA_TYPE,
  MAX_BODY_BYTES,
  MESSAGES,
} from '../../lib/contact-form';
import {
  handleSubmission,
  type SubmissionKind,
} from '../../lib/contact-submission';
import { CONTACT_PATH, CONTACT_SENT_PATH } from '../../lib/paths';
import { CONTACT_FORM_ON } from '../../lib/contact';

/*
 * The only on-demand page. Renders only on failure, refilling the form;
 * success redirects to the static /contact/sent/. A separate route keeps
 * /contact static and under public/_headers.
 */
export const prerender = false;

/* Error pages repeat what was typed, so no cache may keep them. */
Astro.response.headers.set('Cache-Control', 'no-store, no-transform');

if (!CONTACT_FORM_ON) {
  return new Response('Not found.\n', {
    status: 404,
    headers: Astro.response.headers,
  });
}

if (Astro.request.method !== 'POST') {
  return Astro.redirect(CONTACT_PATH, 303);
}

const body = await readCappedForm(
  Astro.request,
  MAX_BODY_BYTES,
  FORM_MEDIA_TYPE,
);

if (body.kind === 'unsupported' || body.kind === 'unreadable') {
  return Astro.redirect(CONTACT_PATH, 303);
}

/* The body was never read, so this page has no form to refill. */
const TOO_LONG_STATUS = 413;
const TOO_LONG_HEADING = 'Message Too Long';

const outcome =
  body.kind === 'too-large'
    ? null
    : await handleSubmission(
        body.form,
        env,
        Date.now(),
        await rateLimitKey(Astro.request),
      );

if (outcome?.kind === 'sent') {
  return Astro.redirect(CONTACT_SENT_PATH, 303);
}

const STATUS: Record<Exclude<SubmissionKind, 'sent'>, number> = {
  invalid: 422,
  limited: 429,
  failed: 503,
};
Astro.response.status = outcome ? STATUS[outcome.kind] : TOO_LONG_STATUS;

/* Names the cause; the error summary below says the message was not sent. */
const HEADING: Record<Exclude<SubmissionKind, 'sent'>, string> = {
  invalid: 'Check Your Message',
  limited: 'Too Many Messages',
  failed: 'Message Not Saved',
};
const heading = outcome ? HEADING[outcome.kind] : TOO_LONG_HEADING;
---

<BaseLayout
  title={`Error: ${heading}`}
  description="Something went wrong sending your message."
  noCanonical
>
  <PageHero title={heading} titleSize="h2">
    <p class="standfirst">
      {outcome
        ? 'Nothing has been sent yet. What you wrote is still here.'
        : 'Nothing has been sent. Your message is longer than this form accepts.'}
    </p>
  </PageHero>

  <section class="band py-section">
    <div class="mx-auto max-w-page">
      {outcome ? (
        <div class="card max-w-3xl">
          <ContactForm
            errors={outcome.errors}
            values={outcome.values}
            summaryHeading="h2"
            notSent={
              outcome.kind === 'limited' || outcome.kind === 'failed'
                ? outcome.kind
                : undefined
            }
          />
        </div>
      ) : (
        <div class="card">
          <p class="max-w-measure text-body text-text text-pretty">
            {MESSAGES.bodyLong}
          </p>
          <p class="mt-4 text-body text-text">
            <a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a>
          </p>
          <p class="actions mt-head">
            <a href={CONTACT_PATH} class="btn-primary">
              Back to the Contact Form
            </a>
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
