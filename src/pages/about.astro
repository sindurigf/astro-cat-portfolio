---
import type { ImageMetadata } from 'astro';
import { getImage, Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../lib/photo-formats';
import BaseLayout from '../layouts/BaseLayout.astro';
import CatMark from '../components/CatMark.astro';
import CloseRow from '../components/CloseRow.astro';
import PageHero from '../components/PageHero.astro';
import PhotoTile from '../components/PhotoTile.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import Section from '../components/Section.astro';
import PersonaSources from '../components/PersonaSources.astro';
import { PERSONA_SOURCES_ID, SAMPLE_PERSONA } from '../lib/persona';
import AboutCats from '../components/AboutCats.astro';
import '../styles/components/about-cats.css';
import type { CatInfo } from '../lib/about-cats';
import hero from '../assets/photos/calico-cushion.jpg';
import panorama from '../assets/photos/calico-pillow.jpg';
import halfBlack from '../assets/photos/black-cat-bed.jpg';
import halfTabby from '../assets/photos/tabby-blanket.jpg';
import stripPortrait from '../assets/photos/tabby-duvet-portrait.jpg';
import stripPair from '../assets/photos/two-cats-blanket.jpg';
import stripBed from '../assets/photos/tabby-round-bed.jpg';
import stripDuvet from '../assets/photos/calico-floral-duvet.jpg';
import food from '../assets/photos/calico-fabric-bed.jpg';
import videoStill from '../assets/photos/tabby-parquet.jpg';
import catCardTabby from '../assets/photos/cat-card-tabby.jpg';
import catCardCalico from '../assets/photos/cat-card-calico.jpg';
import catCardBlack from '../assets/photos/cat-card-black.jpg';
import { photographerHref, type Photographer } from '../lib/credits';
import { WIDTHS } from '../lib/image-densities';
import { photoSize } from '../lib/photo-size';
import { closeRowLinks } from '../lib/blog';
import { MOTTO, MOTTO_LANGUAGE } from '../lib/site';
import { PERSON_NAME } from '../lib/profiles';

/* Jump links repeat the headings verbatim. */

/* Both `border-4` edges of `PHOTO`. */
const PHOTO_BORDERS = '8px';

/* Drawn widths net of gutter, padding and borders; tests/image-size.spec.ts fails on drift. */
const SIZES = {
  halfCard: `(min-width: 64rem) min(calc(50vw - 108px - ${PHOTO_BORDERS}), calc(34.5rem + 4px - ${PHOTO_BORDERS})), (min-width: 40rem) calc(100vw - 8.5rem - ${PHOTO_BORDERS}), calc(100vw - 5.5rem - ${PHOTO_BORDERS})`,
  /* A half with no gap beside it. */
  single:
    '(min-width: 40rem) min(calc(50vw - 5.25rem), 36.25rem), calc(100vw - 6.5rem)',
} as const;

const PHOTOGRAPHER: Photographer = 'License and Credit';

// TODO(fork): Write your own section titles here, and your own text in the page below.
const SECTIONS = [
  { id: 'motto', title: `Why ${MOTTO.text}` },
  { id: 'believe', title: 'What I Believe' },
  { id: 'people', title: 'My People' },
  { id: 'important-things', title: 'Important Things' },
  { id: 'journey', title: 'How I Got Here' },
] as const;

const JUMP_LINKS = [
  ...SECTIONS,
  ...(SAMPLE_PERSONA === null
    ? []
    : [{ id: PERSONA_SOURCES_ID, title: 'Sources' }]),
];

/* On the `.aspect-frame`, so the border stays when a failed photo fades out. */
const PHOTO = 'border-4 border-border';

/* Uncaptioned; the alt text says what is in each. */
// TODO(fork): Replace these photos with your own, each with a description of what it shows.
const PLACES = [
  {
    src: stripPortrait,
    alt: 'A tabby cat lying on a white duvet, looking at the camera.',
  },
  {
    src: stripPair,
    alt: 'A calico cat and a black cat lying side by side on a checked blanket.',
  },
  {
    src: stripBed,
    alt: 'A tabby cat curled in a round cat bed beside an orange plush toy.',
  },
  {
    src: stripDuvet,
    alt: 'A calico cat asleep on a floral duvet.',
  },
] as const;

// TODO(fork): Replace Robin's three cats with your own (names, photos, photo descriptions), or remove the cats: README "Your cats, or none".
const CATS = [
  {
    id: 'minerva',
    src: catCardTabby,
    name: 'Minerva',
    role: 'Reads over my shoulder.',
    alt: 'A tabby cat asleep with its face pressed into a blue blanket.',
  },
  {
    id: 'hela',
    src: catCardCalico,
    name: 'Hela',
    role: 'Guards the map drawer.',
    alt: 'A calico cat lying on a paisley pillow, mouth open.',
  },
  {
    id: 'rudra',
    src: catCardBlack,
    name: 'Rudra',
    role: 'Sleeps on the warmest book.',
    alt: 'A black cat lying on its back in a round cat bed, eyes wide.',
  },
] as const;

/* Match `.cat-dialog-body`: w-48 on phones, w-72 from md (48rem). */
const CAT_PHOTO_WIDTHS = [192, 288, 384, 576];
const CAT_PHOTO_SIZES = '(min-width: 48rem) 288px, 192px';

const catInfo: CatInfo[] = await Promise.all(
  CATS.map(async (cat) => {
    const photo = await getImage({
      src: cat.src,
      widths: CAT_PHOTO_WIDTHS,
      sizes: CAT_PHOTO_SIZES,
      format: 'webp',
    });
    return {
      id: cat.id,
      name: cat.name,
      role: cat.role,
      photo: {
        src: photo.src,
        srcset: photo.srcSet.attribute,
        sizes: CAT_PHOTO_SIZES,
        width: Number(photo.attributes['width']),
        height: Number(photo.attributes['height']),
        alt: cat.alt,
      },
    };
  }),
);
const panoramaSize = await photoSize(panorama);

/*
 * A `.photo-pair` row from 40rem: the two photos share `min(100vw - 11.5rem,
 * 71.5rem)` in proportion to their ratios, as flex shrinks them to one height.
 */
const pairSizes = async ([left, right]: readonly [
  ImageMetadata,
  ImageMetadata,
]): Promise<[string, string]> => {
  const ratioOf = async (image: ImageMetadata) => {
    const { width, height } = await photoSize(image);
    return width / height;
  };
  const ratios = await Promise.all([ratioOf(left), ratioOf(right)]);
  const total = ratios[0] + ratios[1];
  const sizesFor = (ratio: number) => {
    const share = (ratio / total).toFixed(4);
    return `(min-width: 40rem) min(calc((100vw - 11.5rem) * ${share}), calc(71.5rem * ${share})), calc(100vw - 6.5rem)`;
  };
  return [sizesFor(ratios[0]), sizesFor(ratios[1])];
};
const [halfBlackSizes, halfTabbySizes] = await pairSizes([
  halfBlack,
  halfTabby,
]);

const closeRow = await closeRowLinks({
  href: '/career/',
  label: 'Career',
});
---

<BaseLayout
  title="About"
  description={`${PERSON_NAME}, archaeologist: growing up on Ohara, twenty years on the run, and the Straw Hat Pirates, the crew she sails with now.`}
  profile
>
  <PageHero
    title="About Me"
    image={hero}
    imageAlt="A calico cat asleep, curled against a gray cushion."
  >
    <p class="standfirst">
      I am an archaeologist, the last scholar of Ohara, and a reader of the
      Poneglyphs, the stones most of the world cannot read.
    </p>

    <nav aria-label="On this page" class="mt-8">
      <ul role="list" class="flex flex-wrap gap-6">
        {JUMP_LINKS.map((section) => (
          <li>
            <a href={`#${section.id}`} class="chip">
              {section.id === 'motto' ? (
                <>
                  Why <span lang={MOTTO.lang}>{MOTTO.text}</span>
                </>
              ) : (
                section.title
              )}
              <span class="sr-only">&nbsp;section</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </PageHero>

  <Section id={SECTIONS[0].id} headless>
    <div class="flex flex-wrap items-center gap-6 lg:gap-8">
      <span class="logo-tile mark-throw mark-throw-cat flex shrink-0 rotate-3 lg:mark-throw-large">
        <CatMark body={112} class="size-24 lg:size-32" />
      </span>
      <div class="min-w-0">
        <h2 id="motto-heading" class="text-h2 text-text">
          {/* &nbsp;: an ordinary space beside `.sr-only` collapses and Chromium glues "WHY" to the motto. */}
          <span class="sr-only">Why&nbsp;</span>
          <span lang={MOTTO.lang}>{MOTTO.text}</span>
        </h2>
        {MOTTO.meaning !== null && (
          <p class="mt-3 text-body text-text text-pretty">
            {MOTTO_LANGUAGE} for &ldquo;{MOTTO.meaning}&rdquo;
          </p>
        )}
      </div>
    </div>

    <div class="cat-perch mt-head">
      <div class="cat-spot" id="cat-spot-minerva"></div>
      <div class="card">
        <p class="mb-paragraph max-w-2xl text-lead font-black text-text text-pretty">
          The scholars of Ohara read stones that most of the world cannot. I am
          the one who is left, so I keep reading them.
        </p>
        <p class="mt-4 max-w-measure text-body text-text text-pretty">
          It reminds me to start with what is carved, and only then tell the
          story.
        </p>
      </div>
    </div>
  </Section>

  <Section id={SECTIONS[1].id} title={SECTIONS[1].title}>
    <div class="card-block grid lg:card-rise-room lg:grid-cols-2">
      <blockquote class="card surface-gold flex flex-col justify-center">
        <span aria-hidden="true" class="self-start text-quote-mark font-black">
          &ldquo;
        </span>
        <p class="mt-6 text-h2 font-black text-pretty">
          History belongs to everyone who wants to learn it.
        </p>
      </blockquote>
      <div class="card card-step-1 lg:card-step-0 lg:card-rise-full flex flex-col justify-center">
        <div class:list={['aspect-frame', PHOTO]}>
          <svg
            class="aspect-sizer"
            viewBox={`0 0 ${panoramaSize.width} ${panoramaSize.height}`}
            aria-hidden="true"
            focusable="false"
          />
          <Picture
            {...PHOTO_FORMATS}
            src={panorama}
            alt="A calico cat lying on a paisley pillow, mouth open."
            width={panoramaSize.width}
            height={panoramaSize.height}
            widths={WIDTHS}
            sizes={SIZES.halfCard}
          />
        </div>
      </div>
    </div>
  </Section>

  <Section
    id={SECTIONS[2].id}
    title={SECTIONS[2].title}
    lead="I was alone for twenty years. After Arabasta I asked the Straw Hat Pirates to let me join, and their captain said yes."
  >
    <div class="cat-perch">
      <div class="cat-spot" id="cat-spot-hela"></div>
      <div class="card">
        <div class="photo-pair">
          <PhotoTile
            image={halfBlack}
            alt="A black cat lying on its back in a round cat bed, eyes wide."
            group="people"
            sizes={halfBlackSizes}
          />
          <PhotoTile
            image={halfTabby}
            alt="A tabby cat asleep with its chin on a blue blanket."
            group="people"
            sizes={halfTabbySizes}
          />
        </div>

        <PhotoStrip
          id="people-photos"
          label="More Photos"
          noun="photos"
          group="people"
          photos={PLACES}
        />
      </div>
    </div>
  </Section>

  <Section id={SECTIONS[3].id} title={SECTIONS[3].title}>
    {/* A <dl>, so short bold values are not paragraphs WAVE reads as headings. */}
    <div class="cat-perch">
      <div class="cat-spot" id="cat-spot-rudra"></div>
      <div class="card-block flex flex-col lg:card-rise-room lg:flex-row">
        <dl class="card min-w-0 divide-y-4 divide-border lg:flex-1">
          <div class="pb-6">
            <dt class="label text-gold">Reading</dt>
            <dd class="mt-4">
              <span class="card-title block">Poneglyphs</span>
              <span class="mt-2 block text-body text-text">
                And any book on any island we reach
              </span>
            </dd>
          </div>
          <div class="py-6">
            <dt class="label text-gold">Codename</dt>
            <dd class="card-title mt-4 text-pretty">Miss All Sunday</dd>
          </div>
          <div class="py-6">
            <dt class="label text-gold">Bounty</dt>
            <dd class="card-title mt-4">79,000,000 Berries, from Age Eight</dd>
          </div>
          <div class="pt-6">
            <dt class="label text-gold">Devil Fruit</dt>
            <dd class="mt-4">
              <span class="card-title block">Hana Hana no Mi</span>
              <span class="mt-2 block text-body text-text">
                Hands that bloom on any surface
              </span>
            </dd>
          </div>
        </dl>
        <div class="card card-step-1 lg:card-step-0 lg:card-rise-full lg:flex lg:w-1/2 lg:shrink-0 lg:flex-col lg:justify-center">
          <div class:list={['aspect-frame aspect-square', PHOTO]}>
            <Picture
              {...PHOTO_FORMATS}
              src={food}
              alt="A calico cat lying in a fabric cat bed, looking at the camera."
              widths={WIDTHS}
              sizes={SIZES.halfCard}
            />
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section id={SECTIONS[4].id} title={SECTIONS[4].title}>
    <p slot="lead" class="lead">
      My story so far, in two halves: the island that raised me, and the twenty
      years after it.
    </p>

    <div class="card">
      <div class="flex flex-col gap-8 sm:flex-row">
        <div class="min-w-0 sm:flex-1">
          <span class="label block text-gold">Before</span>
          <p class="mt-3 text-body text-text text-pretty">
            I grew up on Ohara, reading in the library inside the Tree of
            Knowledge. Its director, Professor Clover, let me read there, and I
            passed the archaeology exam at eight. My mother, Olvia, was away
            searching for Poneglyphs for most of my childhood. That same year a
            Buster Call destroyed the island, and I was the only one who
            survived.
          </p>
        </div>
        <div class="min-w-0 sm:flex-1">
          <span class="label block text-gold">After</span>
          <p class="mt-3 text-body text-text text-pretty">
            A giant named Saul protected me and helped me get away. For about
            twenty years I ran, with a bounty on my head from the age of eight.
            I worked for Baroque Works as Miss All Sunday. After Arabasta I
            asked the Straw Hats to let me join, and their captain said yes.
          </p>
        </div>
      </div>

      <div class="mt-8">
        <div class="min-w-0 sm:w-1/2">
          <PhotoTile
            image={videoStill}
            alt="A tabby cat lying on its back on a parquet floor, a wand toy by its paw."
            group="journey"
            sizes={SIZES.single}
          >
            <span class="block font-black text-text">A Quiet Afternoon</span>
            Photo: <a href={photographerHref(PHOTOGRAPHER)}>{PHOTOGRAPHER}</a>
          </PhotoTile>
        </div>
      </div>
    </div>
  </Section>

  {SAMPLE_PERSONA !== null && (
    <Section id={PERSONA_SOURCES_ID} title="Sources">
      <p slot="lead" class="lead">
        Every story on this page comes from the One Piece manga. Each is checked
        against the One Piece Wiki.
      </p>
      <div class="card">
        <PersonaSources
          sources={SAMPLE_PERSONA.sources}
          class="bullet-list max-w-measure text-body text-text text-pretty"
        />
      </div>
    </Section>
  )}

  {/* The cats are drawn by a script; without one, their names and lines are still on the page (ACCESSIBILITY.md, Scripts). */}
  <Section title="The Cats" class="cats-noscript">
    <ul role="list" class="flex flex-col gap-4">
      {CATS.map((cat) => (
        <li class="text-body text-text">
          <strong class="font-black">{cat.name}.</strong> {cat.role}
        </li>
      ))}
    </ul>
  </Section>

  <CloseRow {...closeRow} />

  <PhotoViewer />
  <AboutCats cats={catInfo} />
</BaseLayout>
