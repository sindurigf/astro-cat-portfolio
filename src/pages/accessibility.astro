---
import BaseLayout from '../layouts/BaseLayout.astro';
import Abbr from '../components/Abbr.astro';
import PageHero from '../components/PageHero.astro';
import { accessibilityFacts } from '../lib/accessibility-facts';
import { CONTACT_EMAIL, CONTACT_FORM_ON, CONTACT_MAILTO } from '../lib/contact';
import { ACCESSIBILITY_RESPONSE_DAYS, REPOSITORY_URL } from '../lib/site';

/* A summary of ACCESSIBILITY.md; the volatile facts are derived from it at build time. */
const { targetStandard, conformanceStatus, lastReviewed, publicReporting } =
  accessibilityFacts;

const RESPONSE_TIME = `${ACCESSIBILITY_RESPONSE_DAYS} ${
  ACCESSIBILITY_RESPONSE_DAYS === 1 ? 'day' : 'days'
}`;

const W3C_STATEMENTS = 'https://www.w3.org/WAI/planning/statements/';

const FULL_RECORD = `${REPOSITORY_URL}/blob/main/ACCESSIBILITY.md`;

const COMMITMENT = [
  'WCAG 2.2 AA is the minimum, with AAA text contrast (7:1) everywhere, including under the pointer.',
  'Dark and light mode are both measured. Light mode follows your device, or the switch in the header.',
  'Everything works with a keyboard, and the control you are on is never hidden under the header.',
  'Both animations, the field on the homepage and the cats on the About page, can be paused, and stay still if your device asks for reduced motion.',
];

const SUPPORTED = [
  'paragraphs at most 80 characters wide, with lines 1.5 apart and room between paragraphs',
  'Windows High Contrast Mode',
  'anything you click or tap at least 44 by 44 pixels, with no two overlapping',
  'a distinct, descriptive title on every page',
  ...(CONTACT_FORM_ON
    ? [
        'a contact form with written labels, a focused error summary, and your text kept if sending fails',
      ]
    : []),
];

/* Not counted: a total this page cannot recount would go stale. */
const AUTOMATED = [
  'colour contrast measured against the colour actually behind the text, including every result axe leaves undecided',
  'target sizes, reflow, Windows High Contrast Mode, reduced motion, and navigation with JavaScript off',
  'line length, line spacing and paragraph spacing on every page at three widths',
];
---

<BaseLayout
  title="Accessibility"
  description="What this site aims for, what has been tested, what has not, and how to report a barrier."
>
  {/* The title carries a U+00AD soft hyphen after "Acces": it only paints at a line break. */}
  <PageHero title="Acces­sibility" measure="reading" slab="none">
    <p class="standfirst">
      This site aims to be usable with a keyboard, a <dfn>screen reader</dfn>
      (software that reads the page aloud), at high zoom, and without
      JavaScript. Where it is not, that is a bug worth reporting. It aims for
      the <Abbr short="WCAG" long="Web Content Accessibility Guidelines" /> 2.2
      at Level <Abbr short="AA" long="the middle of WCAG's three levels" />, and
      at Level <Abbr short="AAA" long="the highest of WCAG's three levels" />
      for text contrast.
    </p>
  </PageHero>

  <section class="reading-layout band py-section">
    <div class="mx-auto max-w-page">
      {/* Four spans of three on the twelve-column grid; there is no four-column grid. */}
      <dl class="fact-strip grid gap-0 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <dt class="label text-gold">Target</dt>
          <dd class="mt-4 text-text">{targetStandard}</dd>
        </div>
        <div class="lg:col-span-3">
          <dt class="label text-gold">Status</dt>
          <dd class="mt-4 text-text">{conformanceStatus}</dd>
        </div>
        <div class="lg:col-span-3">
          <dt class="label text-gold">Last reviewed</dt>
          <dd class="mt-4 text-text">
            <time datetime={lastReviewed}>{lastReviewed}</time>
          </dd>
        </div>
        <div class="lg:col-span-3">
          <dt class="label text-gold">Scope</dt>
          <dd class="mt-4 text-text">
            Every page on this site. Sites linked from the footer are not
            covered.
          </dd>
        </div>
      </dl>

      <div class="mx-auto max-w-measure">
        <div class="prose mt-section">
          <h2>Commitment</h2>

          <ul>
            {COMMITMENT.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <h2>What works today</h2>

          <ul>
            <li>navigation without JavaScript</li>
            <li>
              <dfn>reflow</dfn>: at 320px wide, which is 400% zoom on a 1280px
              screen, the page fits without scrolling sideways, with or without
              increased text spacing
            </li>
            {SUPPORTED.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <h2>Supported browsers</h2>

          <p>
            Chrome and Edge 111, Firefox 114 and Safari 16.4 or later, on
            desktop and mobile. Every change is tested in Chromium, Firefox and
            WebKit, the <dfn>engines</dfn> those browsers use to draw pages. No
            screen reader has been tested yet.
          </p>

          <h2>Known gaps</h2>

          <p>
            No screen reader has been used on this site yet, so how it sounds is
            unknown, including how the uppercase headings and labels are read.{' '}
            {CONTACT_FORM_ON &&
              "Nobody has tested the contact form's error messages by hand."}{' '}
            Some functional pages have been edited for shorter sentences, but no
            reader has checked them for plain language. The gold sections have
            only been measured by machine. The published{' '}
            <Abbr short="PDF" long="Portable Document Format" /> files pass an
            automated check but have not been read with a screen reader.
          </p>

          <p>
            If any content here does not work for you, email{' '}
            <a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a> and we can send it
            another way, for example as plain text.
          </p>

          <h2>How it is tested</h2>

          <p>
            These run on every change, in Chromium, Firefox and WebKit, and a
            failure stops the change from going live:
          </p>

          <ul>
            <li>
              <dfn>axe</dfn>, an automated accessibility checker, on every page,
              for WCAG 2.2 A and AA in dark and light mode, including the rules
              axe marks experimental, and for best practice in dark mode
            </li>
            <li>
              the keyboard order, tabbed through in both directions on every
              page type, with every <dfn>focus ring</dfn> (the outline on the
              control you are on) measured where it lands
            </li>
            {AUTOMATED.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <p>
            Automated checks find a minority of accessibility problems. The
            checks that need a person, with a screen reader, at real zoom and
            with motion turned off, are written down and have not been done yet.
          </p>

          <h2>Report a barrier</h2>

          <p>
            If something here blocks you, please say so. You do not need to know
            which guideline it falls under, and you do not need to tell us
            anything about yourself. The page address and what you were trying
            to do are useful, and nothing is required. Anything that stops you
            completing a task is fixed first.
          </p>

          <p>We aim to reply within {RESPONSE_TIME}.</p>
        </div>

        <ul class="actions mt-head">
          <li>
            <a href={CONTACT_MAILTO} class="btn-secondary">
              Email {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            <a href={publicReporting} class="btn-secondary">
              Report it on GitHub
            </a>
          </li>
        </ul>

        <p class="mt-head text-body text-text text-pretty">
          The full record, including every measured contrast ratio and every
          known gap, is kept with the source:{' '}
          <a href={FULL_RECORD}>ACCESSIBILITY.md</a>.
        </p>

        <p class="mt-head text-body text-text text-pretty">
          This is a personal site, so this statement is voluntary. It follows
          the <a href={W3C_STATEMENTS}>model for accessibility statements</a>{' '}
          from the World Wide Web Consortium.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
