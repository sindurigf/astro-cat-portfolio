---
import '../styles/global.css';
import { OG_LOCALE, SITE_LANGUAGE } from '../lib/site-language';
import { themeColor } from '../lib/theme-color';
import { DECK_READY_TIMEOUT_MS } from '../lib/deck-ready';
import { THEME_STORAGE_KEY } from '../lib/theme';
import {
  TEXT_SCALE_KEY,
  TEXT_SCALE_PROPERTY,
  TEXT_SCALE_STEPS,
} from '../lib/text-scale';
/* The woff2 global.css's @font-face names; `?url` gives Vite's hashed path to preload. */
import lexendLatin from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import { structuredDataScript, type ArticleMeta } from '../lib/structured-data';
import type { Trail } from '../lib/breadcrumbs';
import { UMAMI_HOST_URL, UMAMI_SCRIPT_PATH } from '../lib/analytics';
import { ANALYTICS_ON, UMAMI_WEBSITE_ID } from '../lib/analytics-site';
import { pageOgImage } from '../lib/og-image';
import { personImageUrl } from '../lib/person-image';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingTab from '../components/ReadingTab.astro';
import { SITE_FEED_PATH, SITEMAP_PATH } from '../lib/paths';
import {
  BING_SITE_VERIFICATION,
  bingVerificationFor,
  requireSite,
  SITE_NAME,
  SITE_SHORT_NAME,
} from '../lib/site';
import { BUILD_ENV } from '../lib/build-env';

interface Props {
  /** The page's own name; the site name is appended unless `titleSuffix` is false. */
  title: string;
  titleSuffix?: boolean;
  description: string;
  /* For the 404 page, which is served at every dead URL. */
  noCanonical?: boolean;
  /* `noindex, follow`; src/lib/sitemap-filter.ts must drop the same pages. */
  noindex?: boolean;
  article?: ArticleMeta;
  trail?: Trail;
  markdownSource?: string;
  feed?: { title: string; href: string };
  /* /about/ only: the page is the Person's profile. */
  profile?: boolean;
}

const {
  title,
  titleSuffix = true,
  description,
  noCanonical = false,
  noindex = false,
  article,
  trail,
  markdownSource,
  feed,
  profile,
} = Astro.props;

const documentTitle = titleSuffix ? `${title} | ${SITE_NAME}` : title;

const site = requireSite(
  Astro.site,
  'canonical, Open Graph and JSON-LD URLs must be absolute.',
);
const canonical = new URL(Astro.url.pathname, site);
/* Only the production host is counted; localhost and previews send nothing. */
const analyticsDomain = site.hostname;
const bingVerification = bingVerificationFor(
  Astro.url.pathname,
  BING_SITE_VERIFICATION,
);
const ogImage = pageOgImage(Astro.url.pathname);
const ogImageUrl = new URL(ogImage.src, site);
const personImage = await personImageUrl(site);
const articleData = article && {
  ...article,
  description,
  url: canonical,
  image: ogImageUrl,
};
---

<html lang={SITE_LANGUAGE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      `crossorigin` is required though same-origin: fonts load in CORS mode,
      and without it the browser fetches the file twice.
    */}
    <link
      rel="preload"
      href={lexendLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Before the stylesheet arrives; see base.css for why `dark` alone. */}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />

    {/*
      Sets data-theme and the `js` class before first paint. In <head>, not
      beside the switch: an inline script in the header lets it paint half-built.
      Blocked storage throws; the empty catch falls back to the system theme.
      The saved text size sets --text-scale here too, so no page reflows after paint.
      A page restored from the back-forward cache takes the stored choice again:
      another page may have changed it.
      The timer marks a deck whose script never started, so slides.css shows it whole.
    */}
    <script
      is:inline
      define:vars={{
        key: THEME_STORAGE_KEY,
        deckTimeout: DECK_READY_TIMEOUT_MS,
        scaleKey: TEXT_SCALE_KEY,
        scaleProperty: TEXT_SCALE_PROPERTY,
        scaleSteps: TEXT_SCALE_STEPS,
      }}
    >
      document.documentElement.classList.add('js');
      setTimeout(() => {
        document
          .querySelector('[data-deck]:not([data-deck-ready])')
          ?.setAttribute('data-deck-failed', '');
      }, deckTimeout);
      const applyTheme = () => {
        let saved = null;
        try {
          saved = localStorage.getItem(key);
        } catch {}
        document.documentElement.dataset.theme =
          saved === 'light' ||
          (saved !== 'dark' &&
            matchMedia('(prefers-color-scheme: light)').matches)
            ? 'light'
            : 'dark';
      };
      applyTheme();
      addEventListener('pageshow', (event) => {
        if (event.persisted) applyTheme();
      });
      try {
        const scale = Number(localStorage.getItem(scaleKey));
        const root = document.documentElement;
        const setScale = (percent) =>
          root.style.setProperty(scaleProperty, percent / 100);
        if (scale > 100 && scaleSteps.includes(scale)) {
          setScale(scale);
          /* A size this page cannot hold without sideways scroll steps down to one it can (SC 1.4.10). */
          addEventListener('load', () => {
            for (
              let i = scaleSteps.indexOf(scale);
              i > 0 &&
              scaleSteps[i] > 100 &&
              root.scrollWidth > root.clientWidth;
              i--
            )
              setScale(scaleSteps[i - 1]);
          });
        } else if (scale < 100 && scaleSteps.includes(scale)) setScale(scale);
      } catch {}
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {/* Google shows a large image preview only when a page allows it (Search Central, Discover). */}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="max-image-preview:large" />
    )}
    {bingVerification !== null && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}

    {/* tests/sitemap.spec.ts checks this, robots.txt and the build agree. */}
    {!BUILD_ENV.noindex && (
      <link rel="sitemap" type="application/xml" href={SITEMAP_PATH} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={SITE_FEED_PATH}
    />
    {markdownSource && (
      <link rel="alternate" type="text/markdown" href={markdownSource} />
    )}
    {feed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={feed.title}
        href={feed.href}
      />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* favicon.ico must hold 16, 32 and 48 frames (check with `identify`). */}
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48"
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    {/* 180x180, full-bleed. iOS rounds the corners itself; do not pre-round. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={SITE_SHORT_NAME} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <meta property="article:published_time" content={article.datePublished} />
    )}
    {article?.dateModified && (
      <meta property="article:modified_time" content={article.dateModified} />
    )}
    <meta property="og:site_name" content={SITE_NAME} />
    {/* og:site_name already names the site, so og:title has no suffix. */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALE} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />

    {/* Only tags with no og: fallback; X reads og:title, og:description and og:image. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    {/* No CSP hash needed: `script-src` does not gate a non-executed data block. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataScript({
        site,
        siteName: SITE_NAME,
        personImage,
        article: articleData,
        breadcrumbs: trail && { page: canonical, trail },
        profile: profile ? canonical : undefined,
      })}
    ></script>
    {/* `is:inline`: the tracker reads `document.currentScript`, which a module lacks. */}
    {ANALYTICS_ON && (
      <script
        is:inline
        defer
        src={UMAMI_SCRIPT_PATH}
        data-website-id={UMAMI_WEBSITE_ID}
        data-host-url={UMAMI_HOST_URL}
        data-domains={analyticsDomain}
        data-do-not-track="true"
        data-exclude-search="true"
        data-exclude-hash="true"
      ></script>
    )}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    {/* Must be the first focusable element on the page (SC 2.4.1). */}
    <a class="skip-link" href="#main-content">
      Skip to Main Content
    </a>
    <Header />
    {/* tabindex="-1": without it the skip link leaves focus on <body>. */}
    <main id="main-content" tabindex="-1" class="page-gutter flex-1">
      <slot />
    </main>
    <Footer />
    <ReadingTab />
    {ANALYTICS_ON && <script>
      import '../scripts/track-clicks';
    </script>}
    <script>
      import '../scripts/failed-images';
      import '../scripts/focus-into-view';
    </script>
  </body>
</html>
