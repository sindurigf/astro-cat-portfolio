---
import '../styles/global.css';
import { OG_LOCALE, SITE_LANGUAGE } from '../lib/site-language';
import { themeColor } from '../lib/theme-color';
import { THEME_STORAGE_KEY } from '../lib/theme';
/* The woff2 global.css's @font-face names; `?url` gives Vite's hashed path to preload. */
import lexendLatin from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import { structuredDataScript, type ArticleMeta } from '../lib/structured-data';
import { getImage } from 'astro:assets';
import type { Trail } from '../lib/breadcrumbs';
import { UMAMI_HOST_URL, UMAMI_SCRIPT_PATH } from '../lib/analytics';
import { ANALYTICS_ON, UMAMI_WEBSITE_ID } from '../lib/analytics-site';
import { DEFAULT_OG_IMAGE, type OgImage } from '../lib/og-image';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_FEED_PATH, SITEMAP_PATH } from '../lib/paths';
import { requireSite, SITE_NAME, SITE_SHORT_NAME } from '../lib/site';
import { BUILD_ENV } from '../lib/build-env';

interface Props {
  /** The page's own name; the site name is appended unless `titleSuffix` is false. */
  title: string;
  titleSuffix?: boolean;
  description: string;
  ogImage?: OgImage;
  /* For the 404 page, which is served at every dead URL. */
  noCanonical?: boolean;
  /* `noindex, follow`; src/lib/sitemap-filter.ts must drop the same pages. */
  noindex?: boolean;
  article?: ArticleMeta;
  trail?: Trail;
  markdownSource?: string;
  feed?: { title: string; href: string };
  /* /about/ only: the page is the Person's profile, the portrait their image. */
  profile?: { portrait: ImageMetadata };
}

const PERSON_IMAGE_WIDTH = 640;

const {
  title,
  titleSuffix = true,
  description,
  ogImage = DEFAULT_OG_IMAGE,
  noCanonical = false,
  noindex = false,
  article,
  trail,
  markdownSource,
  feed,
  profile,
} = Astro.props;

const documentTitle = titleSuffix ? `${title} | ${SITE_NAME}` : title;

const site = requireSite(
  Astro.site,
  'canonical, Open Graph and JSON-LD URLs must be absolute.',
);
const canonical = new URL(Astro.url.pathname, site);
/* Only the production host is counted; localhost and previews send nothing. */
const analyticsDomain = site.hostname;
const ogImageUrl = new URL(ogImage.src, site);
const personImage =
  profile &&
  new URL(
    (await getImage({ src: profile.portrait, width: PERSON_IMAGE_WIDTH })).src,
    site,
  );
const articleData = article && {
  ...article,
  description,
  url: canonical,
  image: ogImageUrl,
};
---

<html lang={SITE_LANGUAGE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      `crossorigin` is required though same-origin: fonts load in CORS mode,
      and without it the browser fetches the file twice.
    */}
    <link
      rel="preload"
      href={lexendLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Before the stylesheet arrives; see base.css for why `dark` alone. */}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />

    {/*
      Sets data-theme and the `js` class before first paint. In <head>, not
      beside the switch: an inline script in the header lets it paint half-built.
      Blocked storage throws; the empty catch falls back to the system theme.
    */}
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      document.documentElement.classList.add('js');
      let saved = null;
      try {
        saved = localStorage.getItem(key);
      } catch {}
      document.documentElement.dataset.theme =
        saved === 'light' ||
        (saved !== 'dark' &&
          matchMedia('(prefers-color-scheme: light)').matches)
          ? 'light'
          : 'dark';
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* tests/sitemap.spec.ts checks this, robots.txt and the build agree. */}
    {!BUILD_ENV.noindex && (
      <link rel="sitemap" type="application/xml" href={SITEMAP_PATH} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={SITE_FEED_PATH}
    />
    {markdownSource && (
      <link rel="alternate" type="text/markdown" href={markdownSource} />
    )}
    {feed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={feed.title}
        href={feed.href}
      />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* favicon.ico must hold 16, 32 and 48 frames (check with `identify`). */}
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48"
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    {/* 180x180, full-bleed. iOS rounds the corners itself; do not pre-round. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={SITE_SHORT_NAME} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <meta property="article:published_time" content={article.datePublished} />
    )}
    {article?.dateModified && (
      <meta property="article:modified_time" content={article.dateModified} />
    )}
    <meta property="og:site_name" content={SITE_NAME} />
    {/* og:site_name already names the site, so og:title has no suffix. */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALE} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />

    {/* Only tags with no og: fallback; X reads og:title, og:description and og:image. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    {/* No CSP hash needed: `script-src` does not gate a non-executed data block. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataScript({
        site,
        personImage,
        article: articleData,
        breadcrumbs: trail && { page: canonical, trail },
        profile: profile ? canonical : undefined,
      })}
    ></script>
    {/* `is:inline`: the tracker reads `document.currentScript`, which a module lacks. */}
    {ANALYTICS_ON && (
      <script
        is:inline
        defer
        src={UMAMI_SCRIPT_PATH}
        data-website-id={UMAMI_WEBSITE_ID}
        data-host-url={UMAMI_HOST_URL}
        data-domains={analyticsDomain}
        data-do-not-track="true"
        data-exclude-search="true"
        data-exclude-hash="true"
      ></script>
    )}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    {/* Must be the first focusable element on the page (SC 2.4.1). */}
    <a class="skip-link" href="#main-content">
      Skip to Main Content
    </a>
    <Header />
    {/* tabindex="-1": without it the skip link leaves focus on <body>. */}
    <main id="main-content" tabindex="-1" class="page-gutter flex-1">
      <slot />
    </main>
    <Footer />
    {ANALYTICS_ON && <script>
      import '../scripts/track-clicks';
    </script>}
    <script>
      import '../scripts/failed-images';
      import '../scripts/focus-into-view';
    </script>
  </body>
</html>
