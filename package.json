{
  "name": "astro-cat-portfolio",
  "private": true,
  "license": "SEE LICENSE IN README.md",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "astro dev --force",
    "prebuild": "node scripts/seed-image-cache.mjs",
    "build": "astro build --force",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity hint && vue-tsc --noEmit -p tsconfig.vue.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:a11y && npm run test:worker",
    "test:a11y": "playwright test",
    "test:worker": "playwright test -c playwright.worker.config.ts",
    "test:demo": "playwright test -c playwright.demo.config.ts",
    "test:webkit": "sh scripts/test-webkit.sh",
    "test:a11y:ui": "playwright test --ui",
    "test:coverage": "COVERAGE=1 playwright test -c playwright.coverage.config.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:pdf": "node scripts/check-pdf.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:untransformed": "node scripts/check-untransformed.mjs",
    "check:title-case": "node scripts/check-title-case.mjs",
    "check:commits": "sh scripts/check-commits.sh",
    "check:test-weakening": "node scripts/check-test-weakening.mjs",
    "check:exif": "node scripts/check-exif.mjs",
    "check:leaks": "node scripts/check-leaks.mjs",
    "check:fork": "node scripts/check-fork.mjs",
    "check:live": "sh scripts/check-live.sh",
    "check:live:console": "playwright test -c playwright.live.config.ts",
    "check:umami": "sh scripts/check-umami.sh",
    "publish:talk": "node scripts/publish-talk.mjs",
    "og": "node scripts/make-og.mjs",
    "hero-still": "node scripts/make-hero-still.mjs",
    "icons": "node scripts/make-icons.mjs",
    "box-cat": "node scripts/make-box-cat.mjs",
    "check": "npm run check:tokens && npm run check:links && npm run check:pins && npm run check:classes && npm run check:csp && npm run check:untransformed && npm run check:title-case && npm run check:exif && npm run format:check && npm run check:commits && npm run check:leaks && npm run check:fork"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.1.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "js-yaml": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@accesslint/core": "^0.21.0",
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/lexend": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "monocart-reporter": "^2.14.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
