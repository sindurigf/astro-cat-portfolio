#!/bin/sh
# Refuses a push that does not contain the last-fetched main, which the ruleset
# would refuse to merge. Does not fetch: run `git fetch` first.
# Enable with `git config core.hooksPath .githooks`.

set -eu

remote=${1:?pre-push: called without a remote name}
base="refs/remotes/$remote/main"
zero=0000000000000000000000000000000000000000

if ! git rev-parse --verify --quiet "$base" >/dev/null; then
  echo "pre-push: no $remote/main fetched; not checking whether this branch is behind it." >&2
  exit 0
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip deletions and non-branch refs.
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac

  if ! git merge-base --is-ancestor "$base" "$local_sha"; then
    echo "pre-push: ${local_ref#refs/heads/} does not contain $remote/main as last fetched." >&2
    echo "pre-push: merge or rebase onto it first; the ruleset would refuse to merge this." >&2
    status=1
  fi
done

exit $status
