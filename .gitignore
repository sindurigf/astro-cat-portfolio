# build output
dist/

# coverage report, from npm run test:coverage
coverage/

# generated types
.astro/

# dependencies
node_modules/

# logs
*.log
npm-debug.log*

# environment variables
.env
.env.*
!.env.example

# cloudflare: every .dev.vars.<env> holds secrets, as wrangler's own template ignores
.wrangler/
.dev.vars*
!.dev.vars.example

# credentials: an npm auth token, keys and certificates
.npmrc
*.pem
*.key

# editors; only the shared VS Code files are tracked
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# playwright
test-results/
playwright-report/
blob-report/

# design comps and source files; the published CV is in public/
design/

# claude code, per-machine and not shared
.claude/*.local.json
.claude/rules/

# git worktrees; Prettier reads this file too, so it skips them
.claude/worktrees/

# scratch and atomic-write temp files
*.tmp
*.tmp.*

# local scratch
tmp/
