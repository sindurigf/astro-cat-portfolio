# Static assets only. Why each header: ARCHITECTURE.md#security-headers.
# Cloudflare applies every matching rule and comma-joins a repeated header,
# so each name belongs to one rule; `! Cache-Control` detaches the global one.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-1BvDVWLr3QCC20uHhUDi27eDFVJpk1uMQJGIWKUks2I=' 'sha256-tQIkdAw2vqfQ1PjgUE4ML2A4pIV8SByQ1Seeehy6UIc=' 'sha256-jkCMehURkiNOIxA9cIEhymfn4RkYUf2VgZpm5IEVLHE='; style-src 'self' 'sha256-vv9IoKo7BSLbWcUHr3tNmfNVmm5L/9Cfn2H6LMk7/ow='; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), encrypted-media=(), midi=(), hid=(), serial=(), idle-detection=(), screen-wake-lock=(), xr-spatial-tracking=(), publickey-credentials-get=(), clipboard-read=(), sync-xhr=(), unload=(), local-fonts=(), window-management=(), fullscreen=(self)
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: no-transform
  Speculation-Rules: "/speculationrules.json"
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap-index.xml>; rel="sitemap"; type="application/xml", </rss.xml>; rel="alternate"; type="application/rss+xml"

# Content-hashed filenames only: an unhashed file here is frozen for a year.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

# Drop `no-transform` so Cloudflare compresses these. The tracker's URL is not
# hashed, so an hour: no revalidation per page, and an update lands within it.
/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/favicon.*
  ! Cache-Control

/*rss.xml
  ! Cache-Control

# Agents' copy of each post; the HTML page stays canonical.
/blog/*.md
  X-Robots-Tag: noindex

# The page that links a PDF is the search result; crawlers must still fetch
# the file to read this, so robots.txt does not disallow it.
/*.pdf
  X-Robots-Tag: noindex

# Chromium ignores the file under any other type.
/speculationrules.json
  Content-Type: application/speculationrules+json
